# ── Alchemy / Cloudflare ──────────────────────────────────────────────────
ALCHEMY_PASSWORD=
ALCHEMY_STATE_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (Docker Postgres) — used by drizzle-kit and Hyperdrive dev.origin
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/therippleeffect

# Remote Neon — used by drizzle-kit migrate for remote runs and in CI
# Use the DIRECT (non-pooled) connection string from Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxx.us-west-2.aws.neon.tech/therippleeffect?sslmode=require

# PR preview Neon branch — set automatically in CI per PR
# PREVIEW_DATABASE_URL=postgresql://...

# ── App Secrets ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Resend API key — resend.com → API Keys
RESEND_API_KEY=
