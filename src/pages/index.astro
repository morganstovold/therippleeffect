---
import ArrowLink from "../components/ArrowLink.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Photo from "../components/Photo.astro";
import PostCard from "../components/PostCard.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SponsorMarquee from "../components/SponsorMarquee.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { formatDate, getFeaturedEvent, getPosts, getSponsors } from "../lib/content";

// Rendered per request so the featured event drops off once it has passed.
export const prerender = false;

const featuredEvent = await getFeaturedEvent();
const recentPosts = (await getPosts()).slice(0, 3);
const { families } = await getSponsors();
const communityPhoto = "https://images.unsplash.com/photo-1529156069898-49953e39b3ac";

const programs = [
  {
    title: "James Baldwin Scholarship",
    text: "Community service scholarships for graduating Benicia High School seniors.",
    href: "/programs#scholarship",
  },
  ...(await getCollection("programs"))
    .toSorted((a, b) => a.data.order - b.data.order)
    .map((program) => ({ title: program.data.title, text: program.data.summary, href: `/programs#${program.id}` })),
  {
    title: "Community Events",
    text: "Gatherings like our Golf Classic and Kidney Walk team that bring people together for a purpose.",
    href: "/events",
  },
];

const ways = [
  {
    title: "Donate",
    text: "Your contribution funds scholarships for Benicia High School seniors and supports community programs built on James's values.",
    href: "/get-involved#donate",
    label: "Support the Foundation",
  },
  {
    title: "Volunteer",
    text: "Help bring our events to life and serve the community that James has dedicated his life to supporting.",
    href: "/get-involved#volunteer",
    label: "Get in Touch",
  },
  {
    title: "Sponsor",
    text: "Put your business or family name behind our scholarships and events, and join a growing circle of local supporters.",
    href: "/get-involved#sponsor",
    label: "Become a Sponsor",
  },
];
---

<Layout description="A foundation honoring the legacy of James Baldwin, lifelong community leader, mentor, and father. Founded by Terry and Kelly Baldwin.">
  <!-- Hero -->
  <section class="relative flex min-h-[90vh] items-center overflow-hidden border-b border-gold/20">
    <div class="absolute inset-0 z-0">
      <Photo src={communityPhoto} alt="" width={1600} priority class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-navy-deep/88"></div>
      <div class="absolute inset-0 bg-linear-to-r from-navy-deep/60 to-transparent"></div>
    </div>

    <div class="relative z-10 page-container py-24 md:py-32">
      <div class="max-w-3xl">
        <Eyebrow tone="light" class="reveal mb-4">Small Actions. Big Impact.</Eyebrow>
        <h1
          class="reveal reveal-d1 mb-6 font-playfair text-[2.75rem] leading-[1.05] font-bold text-white md:text-[4rem] lg:text-[5.25rem]"
        >
          The Ripple Effect<br />of Life
        </h1>
        <p class="reveal reveal-d2 mb-10 max-w-xl text-[1.1rem] leading-[1.7] text-white/85 md:text-[1.25rem]">
          A foundation honoring the legacy of James Baldwin, lifelong community leader, mentor, and father.
        </p>
        <div class="reveal reveal-d3 flex flex-col gap-4 sm:flex-row">
          <Button href="/get-involved" variant="gold">Support the Foundation</Button>
          {
            featuredEvent ? (
              <Button href={`/events/${featuredEvent.id}`} variant="secondary">
                {featuredEvent.data.shortTitle ?? featuredEvent.data.title} ·{" "}
                {formatDate(featuredEvent.data.date, { month: "long", day: "numeric" })}
              </Button>
            ) : (
              <Button href="/about" variant="secondary">
                Our Story
              </Button>
            )
          }
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 opacity-40" aria-hidden="true">
      <div class="relative h-12 w-px overflow-hidden bg-white/50">
        <div class="absolute top-0 left-0 h-2/5 w-full animate-scroll-line bg-gold"></div>
      </div>
    </div>
  </section>

  <!-- About James -->
  <Section tone="cream">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow="The Man Behind the Mission" title="James Baldwin" class="mb-8">
          <p>
            The Ripple Effect of Life was created in honor of James Baldwin, a lifelong community leader whose heart for
            service and people has touched countless lives in Benicia, California.
          </p>
          <p>
            After James was diagnosed with kidney cancer, his family felt the community's support firsthand. Inspired by
            that support and his lifetime of giving back, his wife Terry and daughter Kelly founded this foundation in
            February 2026 so his spirit of service continues to inspire future generations.
          </p>
        </SectionHeading>
        <ArrowLink href="/about" class="reveal">Read His Full Story</ArrowLink>
      </div>
      <div class="reveal reveal-d1 relative">
        <div class="absolute -top-4 right-4 bottom-4 -left-4 -z-10 border border-gold"></div>
        <Photo
          src={communityPhoto}
          alt="Community"
          width={900}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="h-80 w-full object-cover lg:h-[420px]"
        />
      </div>
    </div>
  </Section>

  <!-- Programs -->
  <Section tone="white">
    <div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading eyebrow="What We Do" title="Creating Ripples That Last" class="" />
      <ArrowLink href="/programs" class="reveal shrink-0">All Programs</ArrowLink>
    </div>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        programs.map((program, i) => (
          <li class={`reveal reveal-d${Math.min(i + 1, 4)}`}>
            <a
              href={program.href}
              class="group flex h-full flex-col border-t-2 border-gold bg-cream p-7 no-underline transition-shadow duration-300 hover:shadow-lg"
            >
              <p class="mb-3 font-playfair text-[1.25rem] leading-snug font-bold text-navy-deep">{program.title}</p>
              <p class="mb-6 flex-1 text-sm leading-relaxed text-text-mid">{program.text}</p>
              <span class="text-sm font-semibold text-navy-mid transition-colors group-hover:text-gold">Learn More →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- How to help -->
  <Section tone="navy" class="border-t border-gold/20">
    <SectionHeading eyebrow="Make an Impact" title="How You Can Help" tone="light" />
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        ways.map((way, i) => (
          <div
            class={`reveal reveal-d${i + 1} flex flex-col border-t-2 border-gold bg-white/5 p-8 transition-colors duration-300 hover:bg-white/8 md:p-10`}
          >
            <h3 class="mb-3 font-playfair text-[1.5rem] font-bold text-white">{way.title}</h3>
            <p class="mb-8 flex-1 text-[0.95rem] leading-relaxed text-white/80">{way.text}</p>
            <div>
              <Button href={way.href} variant={i === 0 ? "gold" : "secondary"} size="sm">
                {way.label}
              </Button>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Photo break -->
  <div class="relative h-64 overflow-hidden md:h-80">
    <Photo
      src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622"
      alt="Community gathering"
      width={2000}
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-navy-deep/50"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <p
        class="max-w-2xl px-6 text-center font-playfair text-[1.5rem] leading-[1.3] font-bold text-white italic md:text-[2.25rem]"
      >
        "Every act of kindness creates a ripple with no logical end."
      </p>
    </div>
  </div>

  <!-- Featured event -->
  {
    featuredEvent && (
      <Section tone="cream">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
          <div>
            <SectionHeading eyebrow="Upcoming Event" title={featuredEvent.data.title} class="mb-8">
              <p>{featuredEvent.data.summary}</p>
            </SectionHeading>
            <dl class="reveal mb-8 space-y-1.5 border-l-4 border-gold pl-5 text-sm">
              <div>
                <dt class="inline font-semibold text-navy-deep">Date:</dt>{" "}
                <dd class="inline">{formatDate(featuredEvent.data.date, { dateStyle: "full" })}</dd>
              </div>
              {featuredEvent.data.format && (
                <div>
                  <dt class="inline font-semibold text-navy-deep">Format:</dt>{" "}
                  <dd class="inline">{featuredEvent.data.format}</dd>
                </div>
              )}
              {featuredEvent.data.pricing.length > 0 && (
                <div>
                  <dt class="inline font-semibold text-navy-deep">Pricing:</dt>{" "}
                  <dd class="inline">
                    {featuredEvent.data.pricing.map((price) => `${price.amount} ${price.label}`).join(" / ")}
                  </dd>
                </div>
              )}
            </dl>
            <div class="reveal flex flex-col gap-4 sm:flex-row">
              <Button href={featuredEvent.data.registrationUrl}>{featuredEvent.data.registrationLabel}</Button>
              <ArrowLink href={`/events/${featuredEvent.id}`} class="self-center">
                View Details
              </ArrowLink>
            </div>
          </div>
          <div class="reveal reveal-d1 border border-gold/30 bg-navy-deep p-12 text-center md:p-16">
            <p class="mb-6 text-[0.65rem] font-semibold tracking-[0.2em] text-gold uppercase">Save the Date</p>
            <p class="mb-2 font-playfair text-[4rem] leading-none font-bold text-white md:text-[5rem]">
              {formatDate(featuredEvent.data.date, { month: "short", day: "numeric" })}
            </p>
            <p class="mb-8 font-playfair text-[1.75rem] text-white/75">
              {formatDate(featuredEvent.data.date, { year: "numeric" })}
            </p>
            <div class="mx-auto mb-8 h-px w-10 bg-gold" />
            {featuredEvent.data.venue && <p class="mb-1 text-sm text-white">{featuredEvent.data.venue}</p>}
            {featuredEvent.data.city && <p class="text-xs text-white/60">{featuredEvent.data.city}</p>}
          </div>
        </div>
      </Section>
    )
  }

  <!-- Sponsors: the logo strip runs edge to edge, so this section skips the page container -->
  <section class="border-t border-navy-deep/8 bg-white py-20 md:py-28">
    <div class="page-container mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading eyebrow="With Gratitude" title="Thank You to Our Sponsors" class="">
        <p>
          The businesses, organizations, and {families.length} families who make our scholarships and community events
          possible.
        </p>
      </SectionHeading>
      <ArrowLink href="/sponsors" class="reveal shrink-0">See All Sponsors</ArrowLink>
    </div>
    <SponsorMarquee />
  </section>

  <!-- News -->
  <Section tone="cream" class="border-t border-navy-deep/8">
    <div class="mb-12 flex items-end justify-between">
      <SectionHeading eyebrow="Latest" title="News & Stories" class="" />
      <ArrowLink href="/news" class="reveal hidden sm:inline-flex">All Posts</ArrowLink>
    </div>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {recentPosts.map((post, i) => <PostCard post={post} class={`reveal reveal-d${i + 1}`} />)}
    </div>
    <ArrowLink href="/news" class="reveal mt-10 sm:hidden">All Posts</ArrowLink>
  </Section>
</Layout>
