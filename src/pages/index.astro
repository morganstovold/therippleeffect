---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import logoImage from '../assets/therippleeffect_logo.png';
---

<Layout title="Home | The Ripple Effect of Life" description="Creating ripples of change. Honoring a legacy of service and empowering future generations.">
  <Navbar />

  <main class="mt-[90px]">
    <!-- Hero Section -->
    <section class="relative min-h-[85vh] bg-gradient-to-br from-cream via-white to-[#f5f7fa] overflow-hidden">
      <!-- Subtle ripple effects -->
      <div class="absolute inset-0 opacity-15">
        <div class="ripple-wave absolute rounded-full border-2 border-navy-mid opacity-0 top-[15%] left-[10%] animate-[ripple_12s_ease-out_infinite]"></div>
        <div class="ripple-wave absolute rounded-full border-2 border-navy-mid opacity-0 top-[55%] right-[15%] animate-[ripple_12s_ease-out_4s_infinite]"></div>
        <div class="ripple-wave absolute rounded-full border-2 border-gold opacity-0 bottom-[20%] left-[50%] animate-[ripple_12s_ease-out_8s_infinite]"></div>
      </div>

      <!-- Main content -->
      <div class="relative z-10 max-w-[1400px] mx-auto px-6 md:px-12 h-full min-h-[85vh] flex items-center">
        <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 md:gap-20 items-center w-full py-12 md:py-20">
          <!-- Left: Logo -->
          <div class="relative animate-[fadeInUp_1s_ease-out_0.2s_both] order-1 lg:order-none">
            <img src={logoImage.src} width={logoImage.width} height={logoImage.height} alt="The Ripple Effect of Life" class="w-full max-w-md mx-auto lg:max-w-none h-auto drop-shadow-[0_30px_60px_rgba(15,41,66,0.15)]" fetchpriority="high" loading="eager" />
          </div>

          <!-- Right: Content -->
          <div class="space-y-6 md:space-y-8 animate-[fadeInUp_1s_ease-out_0.4s_both] order-2 lg:order-none text-center lg:text-left">
            <div class="flex items-center gap-3 justify-center lg:justify-start">
              <div class="w-8 md:w-12 h-px bg-gold"></div>
              <span class="text-navy-mid text-[0.65rem] md:text-xs font-bold tracking-[0.25em] uppercase font-inter">Creating Ripples of Change</span>
            </div>

            <h1 class="text-[2rem] md:text-[2.75rem] lg:text-[3.25rem] leading-[1.1] font-bold text-navy-deep font-playfair">
              Honoring a Legacy of <span class="text-gold italic">Service</span>
            </h1>

            <p class="text-[0.95rem] md:text-[1.1rem] leading-[1.7] text-text-dark font-light font-inter">
              Empowering future generations through scholarships, community events, and a commitment to giving back.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-2">
              <Button href="/about" variant="primary" size="md">Learn More</Button>
              <Button href="/get-involved" variant="gold" size="md">Get Involved</Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Gold Separator -->
    <div class="h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>

    <!-- Mission Section -->
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="text-center mb-12 md:mb-16">
          <div class="flex items-center gap-3 justify-center mb-4">
            <div class="w-8 h-px bg-gold"></div>
            <span class="text-navy-mid text-[0.65rem] md:text-xs font-bold tracking-[0.25em] uppercase font-inter">Our Mission</span>
            <div class="w-8 h-px bg-gold"></div>
          </div>
          <h2 class="text-[2.5rem] md:text-[3rem] font-bold text-navy-deep font-playfair">What Drives Us</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
          <!-- Scholarships -->
          <div class="bg-cream border-l-4 border-gold p-8 lg:p-10 hover:shadow-lg transition-shadow duration-300">
            <span class="font-playfair text-[2.5rem] font-bold text-gold opacity-40 leading-none block mb-4">01</span>
            <svg class="w-8 h-8 text-navy-mid mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" /></svg>
            <h3 class="font-playfair text-[1.35rem] text-navy-deep mb-2">Scholarships</h3>
            <p class="font-inter text-text-mid text-[0.95rem] leading-relaxed">Investing in deserving students and the opportunities they need to thrive.</p>
          </div>

          <!-- Community Events -->
          <div class="bg-cream border-l-4 border-gold p-8 lg:p-10 hover:shadow-lg transition-shadow duration-300">
            <span class="font-playfair text-[2.5rem] font-bold text-gold opacity-40 leading-none block mb-4">02</span>
            <svg class="w-8 h-8 text-navy-mid mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>
            <h3 class="font-playfair text-[1.35rem] text-navy-deep mb-2">Community Events</h3>
            <p class="font-inter text-text-mid text-[0.95rem] leading-relaxed">Bringing people together for meaningful causes and lasting connections.</p>
          </div>

          <!-- Giving Back -->
          <div class="bg-cream border-l-4 border-gold p-8 lg:p-10 hover:shadow-lg transition-shadow duration-300">
            <span class="font-playfair text-[2.5rem] font-bold text-gold opacity-40 leading-none block mb-4">03</span>
            <svg class="w-8 h-8 text-navy-mid mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
            <h3 class="font-playfair text-[1.35rem] text-navy-deep mb-2">Giving Back</h3>
            <p class="font-inter text-text-mid text-[0.95rem] leading-relaxed">Fostering a culture of generosity and service within our community.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Gold Separator -->
    <div class="h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>

    <!-- Featured Event Banner -->
    <section class="relative bg-navy-deep py-16 md:py-24 overflow-hidden">
      <div class="absolute top-0 right-0 w-1/2 h-full bg-linear-to-br from-transparent to-[rgba(212,165,116,0.05)]"></div>

      <div class="relative z-10 max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-12 items-center">
          <!-- Left: Event Info -->
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-px bg-gold"></div>
              <span class="text-gold text-[0.65rem] md:text-xs font-semibold tracking-[0.25em] uppercase font-inter">Upcoming Event</span>
            </div>
            <h2 class="font-playfair text-[2.25rem] md:text-[3rem] text-white mb-4 leading-[1.1]">First Inaugural Golf Classic</h2>
            <p class="font-inter text-[rgba(255,255,255,0.7)] text-[1rem] leading-relaxed mb-6">
              An unforgettable day of golf, community, and giving — where every swing creates lasting impact.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <Button href="/golf-classic" variant="primary" size="md">Event Details</Button>
              <Button href="https://events.golfstatus.com/event/TheRippleEffect" variant="gold" size="md">Register Now</Button>
            </div>
          </div>

          <!-- Right: Date Card -->
          <div class="bg-[rgba(255,255,255,0.05)] border border-[rgba(212,165,116,0.2)] p-8 md:p-12 text-center">
            <span class="block font-inter text-gold text-xs font-semibold tracking-[0.2em] uppercase mb-4">Save the Date</span>
            <span class="block font-playfair text-[3rem] md:text-[4rem] font-bold text-white leading-none mb-2">May 28</span>
            <span class="block font-playfair text-[1.5rem] text-[rgba(255,255,255,0.6)] mb-6">2026</span>
            <div class="w-12 h-px bg-gold mx-auto mb-6"></div>
            <span class="block font-inter text-white text-[1rem] mb-1">Eagle Vines Golf Club</span>
            <span class="block font-inter text-[rgba(255,255,255,0.5)] text-sm">American Canyon, CA</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Gold Separator -->
    <div class="h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>

    <!-- James Baldwin Quote -->
    <section class="bg-cream py-16 md:py-24">
      <div class="max-w-[900px] mx-auto px-6 md:px-12 text-center">
        <div class="p-8 md:p-12 border-l-4 border-gold bg-white">
          <blockquote class="m-0">
            <p class="text-[1.25rem] md:text-[1.5rem] lg:text-[1.75rem] italic leading-[1.6] text-navy-deep font-playfair">"The greatest gift we can give is our time, our presence, and our willingness to show up for each other."</p>
            <cite class="block mt-4 text-sm not-italic font-semibold text-gold-dark tracking-[0.05em] font-inter">— James Baldwin</cite>
          </blockquote>
        </div>
        <a href="/about#james" class="inline-flex items-center gap-2 mt-6 font-inter text-sm text-navy-mid font-semibold hover:text-gold transition-colors duration-300 no-underline tracking-wide">
          Read James's Story
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </section>

    <!-- Gold Separator -->
    <div class="h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>

    <!-- Get Involved -->
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="text-center mb-12">
          <h2 class="text-[2.5rem] md:text-[3rem] font-bold text-navy-deep font-playfair">Make an Impact</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
          <!-- Donate -->
          <div class="text-center p-8">
            <svg class="w-10 h-10 text-gold mx-auto mb-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
            <h3 class="font-playfair text-[1.35rem] text-navy-deep mb-2">Donate</h3>
            <p class="font-inter text-text-mid text-[0.9rem] leading-relaxed mb-6">Support scholarships and community programs.</p>
            <Button href="/get-involved" variant="primary" size="sm">Donate Now</Button>
          </div>

          <!-- Sponsor -->
          <div class="text-center p-8">
            <svg class="w-10 h-10 text-gold mx-auto mb-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" /></svg>
            <h3 class="font-playfair text-[1.35rem] text-navy-deep mb-2">Sponsor</h3>
            <p class="font-inter text-text-mid text-[0.9rem] leading-relaxed mb-6">Align your brand with meaningful community impact.</p>
            <Button href="/get-involved#sponsor" variant="primary" size="sm">Become a Sponsor</Button>
          </div>

          <!-- Volunteer -->
          <div class="text-center p-8">
            <svg class="w-10 h-10 text-gold mx-auto mb-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.05 4.575a1.575 1.575 0 1 0-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 0 1 3.15 0v1.5m-3.15 0 .075 5.925m3.075-5.925v3m0-3a1.575 1.575 0 0 1 3.15 0v3m-3.15 0v3.075M18.375 7.5a1.575 1.575 0 0 1 3.15 0v5.775a7.35 7.35 0 0 1-7.35 7.35h-1.05a7.35 7.35 0 0 1-5.196-2.154l-3.3-3.3a1.575 1.575 0 0 1 2.227-2.227l1.894 1.894V4.575" /></svg>
            <h3 class="font-playfair text-[1.35rem] text-navy-deep mb-2">Volunteer</h3>
            <p class="font-inter text-text-mid text-[0.9rem] leading-relaxed mb-6">Give your time and help us serve our community.</p>
            <Button href="/get-involved#volunteer" variant="primary" size="sm">Get Started</Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
