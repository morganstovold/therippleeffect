---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
---

<Layout title="Contact Us | The Ripple Effect of Life" description="Get in touch with The Ripple Effect of Life. Ask questions, learn about volunteering, sponsorship, and our scholarship program.">
  <Navbar />

  <main class="mt-[90px]">
    <!-- Page Header -->
    <PageHeader
      eyebrow="Reach Out"
      title="Contact Us"
      subtitle="Have questions, want to get involved, or just want to connect? We'd love to hear from you."
    />

    <!-- Contact Section -->
    <section class="bg-white py-16 md:py-24">
      <div class="container mx-auto px-6 md:px-12 max-w-6xl">
        <div class="grid md:grid-cols-2 gap-12 lg:gap-16">

          <!-- Contact Form -->
          <div>
            <h2 class="font-playfair text-2xl md:text-3xl font-bold text-navy-deep mb-8">Send us a Message</h2>

            <form action="#" method="POST" class="space-y-6">
              <!-- Name Field -->
              <div>
                <label for="name" class="text-sm font-semibold text-navy-deep mb-2 block font-inter">
                  Full Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full border border-[rgba(15,41,66,0.15)] focus:border-[#d4a574] focus:outline-none bg-white px-4 py-3 font-inter text-sm text-navy-deep placeholder-gray-400 transition-colors"
                  placeholder="Your name"
                />
              </div>

              <!-- Email Field -->
              <div>
                <label for="email" class="text-sm font-semibold text-navy-deep mb-2 block font-inter">
                  Email Address
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full border border-[rgba(15,41,66,0.15)] focus:border-[#d4a574] focus:outline-none bg-white px-4 py-3 font-inter text-sm text-navy-deep placeholder-gray-400 transition-colors"
                  placeholder="your@email.com"
                />
              </div>

              <!-- Subject Field -->
              <div>
                <label for="subject" class="text-sm font-semibold text-navy-deep mb-2 block font-inter">
                  Subject
                </label>
                <select
                  id="subject"
                  name="subject"
                  required
                  class="w-full border border-[rgba(15,41,66,0.15)] focus:border-[#d4a574] focus:outline-none bg-white px-4 py-3 font-inter text-sm text-navy-deep transition-colors"
                >
                  <option value="">Select a subject</option>
                  <option value="general">General Inquiry</option>
                  <option value="scholarship">Scholarship Questions</option>
                  <option value="sponsorship">Sponsorship</option>
                  <option value="volunteer">Volunteer</option>
                  <option value="golf-classic">Golf Classic</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <!-- Message Field -->
              <div>
                <label for="message" class="text-sm font-semibold text-navy-deep mb-2 block font-inter">
                  Message
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="6"
                  class="w-full border border-[rgba(15,41,66,0.15)] focus:border-[#d4a574] focus:outline-none bg-white px-4 py-3 font-inter text-sm text-navy-deep placeholder-gray-400 transition-colors resize-none"
                  placeholder="Tell us how we can help..."
                ></textarea>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="inline-block px-8 py-3 bg-[#d4a574] text-white font-semibold font-inter text-sm md:text-base hover:bg-[#8a5e2a] transition-colors duration-200"
              >
                Send Message
              </button>
            </form>
          </div>

          <!-- Contact Info Card -->
          <div class="bg-[#faf8f5] p-8 md:p-12 rounded-lg">
            <h2 class="font-playfair text-2xl md:text-3xl font-bold text-navy-deep mb-8">Get In Touch</h2>

            <div class="space-y-8">
              <!-- Email -->
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 mt-1">
                  <svg class="w-6 h-6 text-[#d4a574]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-navy-deep mb-1 font-inter">Email</h3>
                  <a href="mailto:Info@TheRippleEffectOfLife.com" class="text-[#2d5f8d] hover:text-[#d4a574] transition-colors font-inter text-sm">
                    Info@TheRippleEffectOfLife.com
                  </a>
                </div>
              </div>

              <!-- Location -->
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 mt-1">
                  <svg class="w-6 h-6 text-[#d4a574]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-navy-deep mb-1 font-inter">Location</h3>
                  <p class="text-navy-rich font-inter text-sm">Benicia, California</p>
                </div>
              </div>

              <!-- Office Hours -->
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 mt-1">
                  <svg class="w-6 h-6 text-[#d4a574]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-navy-deep mb-1 font-inter">Office Hours</h3>
                  <p class="text-navy-rich font-inter text-sm">Monday - Friday<br/>9:00 AM - 5:00 PM PT</p>
                </div>
              </div>

              <!-- Social Media -->
              <div class="flex items-start gap-4">
                <div class="flex-shrink-0 mt-1">
                  <svg class="w-6 h-6 text-[#d4a574]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-navy-deep mb-2 font-inter">Follow Us</h3>
                  <div class="flex gap-4">
                    <a href="#" class="text-[#2d5f8d] hover:text-[#d4a574] transition-colors" aria-label="Facebook">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                      </svg>
                    </a>
                    <a href="#" class="text-[#2d5f8d] hover:text-[#d4a574] transition-colors" aria-label="Instagram">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0m5.521 17.708c-1.445 1.405-3.339 2.208-5.521 2.208-4.418 0-8-3.582-8-8s3.582-8 8-8c2.182 0 4.076.803 5.521 2.208.681.663 1.272 1.407 1.762 2.217H17.7V9.5h3.596c.11.585.167 1.188.167 1.804 0 4.418-3.582 8-8 8-1.204 0-2.357-.264-3.391-.738.721-.995 1.155-2.205 1.155-3.447 0-3.314-2.686-6-6-6s-6 2.686-6 6 2.686 6 6 6c1.242 0 2.408-.434 3.319-1.154.474 1.034 1.627 1.297 2.831 1.297 2.182 0 4.076-.803 5.521-2.208"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="bg-[#faf8f5] py-16 md:py-24">
      <div class="container mx-auto px-6 md:px-12 max-w-4xl">
        <h2 class="font-playfair text-3xl md:text-4xl font-bold text-navy-deep mb-12 text-center">
          Frequently Asked Questions
        </h2>

        <div class="space-y-0 divide-y divide-[rgba(15,41,66,0.1)]">

          <!-- FAQ Item 1 -->
          <details class="group">
            <summary class="cursor-pointer py-5 font-semibold text-navy-deep font-inter text-lg flex justify-between items-center hover:text-[#d4a574] transition-colors">
              <span>How can I apply for the scholarship?</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </summary>
            <div class="pb-5 font-inter text-navy-rich">
              <p class="mb-3">
                To apply for The Ripple Effect of Life Scholarship, you'll need to meet our eligibility requirements, which include demonstrated academic achievement, community involvement, and financial need. Applications are typically open during spring and fall semesters.
              </p>
              <a href="/about#james" class="inline-block text-[#d4a574] hover:text-[#8a5e2a] font-semibold transition-colors">
                Learn more about our scholarship →
              </a>
            </div>
          </details>

          <!-- FAQ Item 2 -->
          <details class="group">
            <summary class="cursor-pointer py-5 font-semibold text-navy-deep font-inter text-lg flex justify-between items-center hover:text-[#d4a574] transition-colors">
              <span>How do I register for the Golf Classic?</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </summary>
            <div class="pb-5 font-inter text-navy-rich">
              <p class="mb-3">
                Our annual Golf Classic is a wonderful way to network while supporting our mission. Registration opens four weeks prior to the event and includes 18 holes of golf, cart rental, lunch, and awards ceremony.
              </p>
              <a href="#" class="inline-block text-[#d4a574] hover:text-[#8a5e2a] font-semibold transition-colors">
                Register for Golf Classic →
              </a>
            </div>
          </details>

          <!-- FAQ Item 3 -->
          <details class="group">
            <summary class="cursor-pointer py-5 font-semibold text-navy-deep font-inter text-lg flex justify-between items-center hover:text-[#d4a574] transition-colors">
              <span>How can I become a sponsor?</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </summary>
            <div class="pb-5 font-inter text-navy-rich">
              <p class="mb-3">
                We offer sponsorship at several levels: Gold ($10,000+), Silver ($5,000-$9,999), and Bronze ($1,000-$4,999). Each level provides unique benefits and recognition opportunities. Sponsors receive prominent visibility in our communications and events.
              </p>
              <p class="mb-3">Contact us at Info@TheRippleEffectOfLife.com to discuss sponsorship opportunities tailored to your organization.</p>
            </div>
          </details>

          <!-- FAQ Item 4 -->
          <details class="group">
            <summary class="cursor-pointer py-5 font-semibold text-navy-deep font-inter text-lg flex justify-between items-center hover:text-[#d4a574] transition-colors">
              <span>Is my donation tax-deductible?</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </summary>
            <div class="pb-5 font-inter text-navy-rich">
              <p>
                Yes! The Ripple Effect of Life is a registered 501(c)(3) nonprofit organization. All donations are fully tax-deductible to the extent allowed by law. We'll provide you with a receipt for your records. Consult with your tax advisor regarding your specific situation.
              </p>
            </div>
          </details>

          <!-- FAQ Item 5 -->
          <details class="group">
            <summary class="cursor-pointer py-5 font-semibold text-navy-deep font-inter text-lg flex justify-between items-center hover:text-[#d4a574] transition-colors">
              <span>How can I volunteer?</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </summary>
            <div class="pb-5 font-inter text-navy-rich">
              <p class="mb-3">
                We're always looking for passionate volunteers! Whether you can help with event planning, community outreach, administrative support, or fundraising, there's a way for you to make an impact.
              </p>
              <p>Send us an email at Info@TheRippleEffectOfLife.com with your interests and availability, and we'll connect you with the right opportunity.</p>
            </div>
          </details>

          <!-- FAQ Item 6 -->
          <details class="group">
            <summary class="cursor-pointer py-5 font-semibold text-navy-deep font-inter text-lg flex justify-between items-center hover:text-[#d4a574] transition-colors">
              <span>Who is James Baldwin?</span>
              <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </summary>
            <div class="pb-5 font-inter text-navy-rich">
              <p class="mb-3">
                James Baldwin was an influential American writer and civil rights activist whose work explored themes of identity, love, and social justice. Our nonprofit's mission is inspired by his powerful legacy of creating positive change.
              </p>
              <a href="/about#james" class="inline-block text-[#d4a574] hover:text-[#8a5e2a] font-semibold transition-colors">
                Learn more about James Baldwin →
              </a>
            </div>
          </details>

        </div>
      </div>
    </section>

    <!-- Location Section -->
    <section class="bg-white py-12 md:py-16">
      <div class="container mx-auto px-6 md:px-12 text-center">
        <h2 class="font-playfair text-2xl md:text-3xl font-bold text-navy-deep mb-2">
          Based in Benicia, California
        </h2>
        <p class="text-navy-rich font-inter text-lg">
          Serving our community with pride
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
