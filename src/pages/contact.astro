---
import { actions, isInputError } from "astro:actions";
import { env } from "cloudflare:workers";
import { subjects } from "../actions";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PageHeader from "../components/PageHeader.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Layout from "../layouts/Layout.astro";
import { site } from "../site";

// Rendered on request so the form can show the result of a submission.
export const prerender = false;

const result = Astro.getActionResult(actions.contact);
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const formError = result?.error && !isInputError(result.error) ? result.error.message : undefined;
const sent = result?.data?.sent === true;

const email = `<a href="mailto:${site.email}">${site.email}</a>`;
const faqs = [
  {
    question: "How can I apply for the scholarship?",
    answer: `<p>The James Baldwin Community Service Scholarship is open to graduating Benicia High School seniors who plan to attend college, trade school, or a vocational program and have a demonstrated record of community service and commitment to making a positive impact.</p><a href="/programs">View scholarship details and apply →</a>`,
  },
  {
    question: "How do I register for an event?",
    answer: `<p>Every event has its own page with dates, pricing, and a registration link.</p><a href="/events">See upcoming events →</a>`,
  },
  {
    question: "How can I become a sponsor?",
    answer: `<p>Contact us at ${email} to learn about sponsorship opportunities.</p>`,
  },
  {
    question: "Is my donation tax-deductible?",
    answer: `<p>We are in the process of obtaining 501(c)(3) status. Please contact us at ${email} for the latest information on tax deductibility.</p>`,
  },
  {
    question: "How can I volunteer?",
    answer: `<p>We're always looking for people who want to help. Whether you can assist with event operations, community outreach, or mentorship, there's a role for you.</p><p>Send us an email at ${email} with your interests and availability.</p>`,
  },
  {
    question: "Who is James Baldwin?",
    answer: `<p>James Baldwin is a lifelong community leader in Benicia, California (not the famous author of the same name). For decades he has given his time coaching youth sports, mentoring young people, and organizing events that bring the Benicia community together.</p><p>This foundation was created by his wife Terry Baldwin and daughter Kelly Baldwin to honor his legacy of service and ensure it continues to inspire future generations.</p><a href="/about">Read his full story →</a>`,
  },
];

const labelClass = "mb-3 block text-xs font-semibold tracking-[0.08em] text-navy-deep uppercase";
const inputClass =
  "w-full border border-navy-deep/15 bg-white px-4 py-3.5 text-sm text-navy-deep placeholder-navy-deep/30 transition-colors focus:border-navy-mid focus:outline-none";
const errorClass = "mt-2 text-sm text-red-700";
---

<Layout
  title="Contact Us"
  description="Get in touch with The Ripple Effect of Life. Ask questions, learn about volunteering, our events, and our scholarship program."
>
  <PageHeader
    eyebrow="Reach Out"
    title="Contact Us"
    subtitle="Have questions or want to get involved? We'd love to hear from you."
  />

  <section class="bg-cream py-20 md:py-28">
    <div class="page-container grid grid-cols-1 gap-12 lg:grid-cols-[3fr_2fr] lg:gap-16">
      <div>
        <h2 class="mb-8 font-playfair text-[1.75rem] font-bold text-navy-deep md:text-[2rem]">Send us a Message</h2>

        {
          sent ? (
            <div class="border-l-4 border-gold bg-white p-8" role="status">
              <p class="mb-2 font-playfair text-[1.5rem] font-bold text-navy-deep">Thank you!</p>
              <p class="text-text-mid">Your message is on its way. We'll get back to you as soon as we can.</p>
            </div>
          ) : (
            <form method="POST" action={actions.contact} class="space-y-7">
              {formError && (
                <p class="border-l-4 border-red-700 bg-white p-4 text-sm text-red-700" role="alert">
                  {formError}
                </p>
              )}
              <div>
                <label for="name" class={labelClass}>
                  Full Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="Your name"
                  class={inputClass}
                />
                {fieldErrors.name && <p class={errorClass}>{fieldErrors.name[0]}</p>}
              </div>
              <div>
                <label for="email" class={labelClass}>
                  Email Address
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="your@email.com"
                  class={inputClass}
                />
                {fieldErrors.email && <p class={errorClass}>{fieldErrors.email[0]}</p>}
              </div>
              <div>
                <label for="subject" class={labelClass}>
                  Subject
                </label>
                <select id="subject" name="subject" required class={inputClass}>
                  <option value="">Select a subject</option>
                  {Object.entries(subjects).map(([value, label]) => (
                    <option value={value}>{label}</option>
                  ))}
                </select>
                {fieldErrors.subject && <p class={errorClass}>{fieldErrors.subject[0]}</p>}
              </div>
              <div>
                <label for="message" class={labelClass}>
                  Message
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="6"
                  placeholder="How can we help?"
                  class:list={[inputClass, "resize-none"]}
                />
                {fieldErrors.message && <p class={errorClass}>{fieldErrors.message[0]}</p>}
              </div>
              <div class="hidden" aria-hidden="true">
                <label for="website">Leave this field empty</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
              </div>
              <div class="cf-turnstile" data-sitekey={env.TURNSTILE_SITE_KEY} data-theme="light" />
              <Button type="submit" variant="gold">
                Send Message
              </Button>
            </form>
          )
        }
      </div>

      <div class="flex flex-col justify-between bg-navy-deep p-10 md:p-14">
        <div>
          <Eyebrow tone="light" class="mb-5">Direct Contact</Eyebrow>
          <h2 class="mb-6 font-playfair text-[1.75rem] font-bold text-white md:text-[2rem]">We'd love to hear from you.</h2>
          <p class="mb-10 text-[0.95rem] leading-relaxed text-white/75">
            Whether you have questions about the scholarship, want to attend an event, or are interested in supporting the
            foundation, reach out and we'll get back to you.
          </p>

          <div class="mb-8 border-t border-gold/20 pt-8">
            <p class="mb-3 text-xs font-semibold tracking-widest text-gold uppercase">Email</p>
            <a href={`mailto:${site.email}`} class="text-base text-white no-underline transition-colors hover:text-gold">
              {site.email}
            </a>
          </div>

          <div class="border-t border-gold/20 pt-8">
            <p class="mb-4 text-xs font-semibold tracking-widest text-gold uppercase">Follow Us</p>
            <SocialLinks iconClass="size-5" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-sand py-20 md:py-28">
    <div class="mx-auto max-w-[900px] px-6 md:px-12">
      <h2 class="mb-12 font-playfair text-[2rem] font-bold text-navy-deep md:text-[2.5rem]">Frequently Asked Questions</h2>
      <div class="divide-y divide-navy-deep/8">
        {
          faqs.map(({ question, answer }) => (
            <details class="group py-1">
              <summary class="flex cursor-pointer items-center justify-between py-5 text-base font-semibold text-navy-deep transition-colors hover:text-navy-mid">
                <span>{question}</span>
                <svg
                  class="size-4 shrink-0 text-gold transition-transform group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div
                class="space-y-3 pb-6 text-sm leading-relaxed text-text-mid [&_a]:font-semibold [&_a]:text-navy-mid [&_a]:no-underline [&_a:hover]:text-navy-deep"
                set:html={answer}
              />
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
