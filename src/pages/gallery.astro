---
import { getCollection } from "astro:content";
import LocalImage from "../components/LocalImage.astro";
import Photo from "../components/Photo.astro";
import ArrowLink from "../components/ArrowLink.astro";
import { formatDate } from "../lib/content";
import familyImage from "../assets/family.jpg";
import CallToAction from "../components/CallToAction.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Layout from "../layouts/Layout.astro";
import { site } from "../site";

// Photos added to past events (see src/content/events) appear here automatically.
const eventsWithPhotos = (await getCollection("events"))
  .filter((event) => event.data.photos.length > 0)
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
  title="Gallery"
  description="Explore our gallery of moments from events, community gatherings, and lives we've touched through The Ripple Effect of Life nonprofit."
>
  <PageHeader
    eyebrow="Moments That Matter"
    title="Gallery"
    subtitle="A collection of moments from our events, community, and the lives we've touched."
  />

  {
    eventsWithPhotos.map((event) => (
      <Section tone="white" class="border-b border-navy-deep/8">
        <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <SectionHeading eyebrow={formatDate(event.data.date)} title={event.data.title} class="" />
          <ArrowLink href={`/events/${event.id}#recap`} class="reveal shrink-0">
            Event Recap
          </ArrowLink>
        </div>
        <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
          {event.data.photos.map((photo) => (
            <li class="reveal aspect-square overflow-hidden bg-cream">
              <Photo
                src={photo.src}
                alt={photo.alt}
                width={800}
                sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
                class="h-full w-full object-cover"
              />
            </li>
          ))}
        </ul>
      </Section>
    ))
  }

  {
    eventsWithPhotos.length === 0 && (
      <Section tone="white" compact>
        <p class="reveal mx-auto max-w-xl text-center text-text-mid">
          Photos from our events will appear here as they're added. Check back soon.
        </p>
      </Section>
    )
  }

  <Section tone="cream">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal relative">
        <div class="absolute -top-4 right-4 bottom-4 -left-4 border border-gold"></div>
        <LocalImage src={familyImage} alt="James with his beloved family" class="relative h-auto w-full" />
      </div>
      <SectionHeading eyebrow="Featured Moment" title="James with his beloved family" class="reveal-d1">
        <p>
          At the heart of The Ripple Effect of Life is a personal story. James's journey, shaped by the love and support of
          his family, inspired the creation of this nonprofit. Every scholarship awarded, every community event hosted, and
          every life touched carries forward the values of compassion, opportunity, and connection that define his family's
          legacy.
        </p>
        <p class="border-l-4 border-gold pl-4 text-navy-mid italic">
          "True impact isn't measured in single moments, but in the ripples that extend far beyond what we can see."
        </p>
      </SectionHeading>
    </div>
  </Section>

  <CallToAction eyebrow="Share" title="Have photos to share?">
    We'd love to see your moments from our events and community gatherings.
    <Fragment slot="actions">
      <Button href={`mailto:${site.email}`} variant="gold">Email Your Photos</Button>
    </Fragment>
  </CallToAction>
</Layout>
