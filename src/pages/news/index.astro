---
import Button from "../../components/Button.astro";
import CallToAction from "../../components/CallToAction.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import PageHeader from "../../components/PageHeader.astro";
import Photo from "../../components/Photo.astro";
import PostCard from "../../components/PostCard.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getPosts } from "../../lib/content";

const posts = await getPosts();
const featured = posts.find((post) => post.data.featured);
const others = posts.filter((post) => post !== featured);
---

<Layout title="News & Stories" description="Updates, stories, and announcements from The Ripple Effect of Life foundation.">
  <PageHeader
    eyebrow="News & Stories"
    title="From the Foundation"
    subtitle="Updates, event recaps, scholarship announcements, and stories from the community."
  />

  {
    featured && (
      <section class="border-b border-navy-deep/8 bg-cream py-20 md:py-28">
        <div class="page-container">
          <Eyebrow class="reveal mb-10">Featured</Eyebrow>
          <a
            href={`/news/${featured.id}`}
            class="group reveal grid grid-cols-1 overflow-hidden border border-navy-deep/10 no-underline lg:grid-cols-2"
          >
            <div class="relative h-64 overflow-hidden lg:h-auto">
              <Photo
                src={featured.data.image}
                alt={featured.data.imageAlt}
                width={1200}
                sizes="(min-width: 1024px) 50vw, 100vw"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-navy-deep/20 transition-colors duration-300 group-hover:bg-navy-deep/10" />
            </div>
            <div class="flex flex-col justify-center bg-white p-8 md:p-12">
              <span class="mb-5 self-start border border-gold/40 px-3 py-1 text-[0.65rem] font-semibold tracking-[0.18em] text-gold uppercase">
                {featured.data.category}
              </span>
              <h2 class="mb-4 font-playfair text-[1.5rem] leading-[1.2] font-bold text-navy-deep transition-colors duration-200 group-hover:text-navy-mid md:text-[2rem]">
                {featured.data.title}
              </h2>
              <p class="mb-6 text-[0.95rem] leading-relaxed text-text-mid">{featured.data.excerpt}</p>
              <div class="mt-auto flex items-center justify-between">
                <p class="text-xs text-text-mid">{formatDate(featured.data.date)}</p>
                <span class="text-sm font-semibold text-navy-mid transition-colors duration-200 group-hover:text-gold">
                  Read More →
                </span>
              </div>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <section class="bg-white py-20 md:py-28">
    <div class="page-container">
      <Eyebrow class="reveal mb-12">All Posts</Eyebrow>
      {
        others.length > 0 ? (
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {others.map((post, i) => (
              <PostCard post={post} showExcerpt class={`reveal reveal-d${Math.min(i + 1, 4)}`} />
            ))}
          </div>
        ) : (
          <p class="text-sm text-text-mid">More posts coming soon.</p>
        )
      }
    </div>
  </section>

  <CallToAction eyebrow="Stay Connected" title="Never miss an update.">
    Scholarship announcements, event news, and community stories, straight from the foundation.
    <Fragment slot="actions">
      <Button href="/contact" variant="gold">Get in Touch</Button>
    </Fragment>
  </CallToAction>
</Layout>
