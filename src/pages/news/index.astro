---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import { posts, getFeaturedPost, getRecentPosts, formatDate } from '../../data/posts';

// TODO: Replace with backend query:
//   const posts = await fetch('/api/posts').then(r => r.json());
const featuredPost = getFeaturedPost();
const otherPosts = getRecentPosts(10).filter(p => !p.featured);
---

<Layout
  title="News & Stories | The Ripple Effect of Life"
  description="Updates, stories, and announcements from The Ripple Effect of Life foundation."
>
  <Navbar />

  <main class="mt-[72px]">

    <PageHeader
      eyebrow="News & Stories"
      title="From the Foundation"
      subtitle="Updates, event recaps, scholarship announcements, and stories from the community."
    />

    <!-- Featured Post -->
    {featuredPost && (
      <section class="bg-[#faf8f5] py-16 md:py-24 border-b border-[rgba(15,41,66,0.08)]">
        <div class="max-w-[1400px] mx-auto px-6 md:px-12">
          <div class="flex items-center gap-3 mb-10 reveal">
            <div class="w-8 h-px bg-gold"></div>
            <p class="text-[0.7rem] font-semibold tracking-[0.18em] uppercase text-gold-dark font-inter">Featured</p>
          </div>

          <a href={`/news/${featuredPost.slug}`} class="group no-underline block reveal">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 overflow-hidden border border-[rgba(15,41,66,0.1)]">
              <div class="relative overflow-hidden h-64 lg:h-auto">
                <img
                  src={featuredPost.image}
                  alt={featuredPost.imageAlt}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-navy-deep/20 group-hover:bg-navy-deep/10 transition-colors duration-300"></div>
              </div>
              <div class="bg-white p-8 md:p-12 flex flex-col justify-center">
                <span class="inline-block text-[0.65rem] font-semibold tracking-[0.18em] uppercase text-gold font-inter border border-[rgba(212,165,116,0.4)] px-3 py-1 mb-5 self-start">
                  {featuredPost.category}
                </span>
                <h2 class="font-playfair text-[1.5rem] md:text-[2rem] font-bold text-navy-deep leading-[1.2] mb-4 group-hover:text-navy-mid transition-colors duration-200">
                  {featuredPost.title}
                </h2>
                <p class="font-inter text-text-mid text-[0.95rem] leading-relaxed mb-6">
                  {featuredPost.excerpt}
                </p>
                <div class="flex items-center justify-between mt-auto">
                  <p class="font-inter text-xs text-text-mid">{formatDate(featuredPost.publishedAt)}</p>
                  <span class="inline-flex items-center gap-2 font-inter text-sm font-semibold text-navy-mid group-hover:text-gold transition-colors duration-200">
                    Read More
                    <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                  </span>
                </div>
              </div>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- All Posts Grid -->
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">

        <div class="flex items-center gap-3 mb-12 reveal">
          <div class="w-8 h-px bg-gold"></div>
          <p class="text-[0.7rem] font-semibold tracking-[0.18em] uppercase text-gold-dark font-inter">All Posts</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {otherPosts.map((post, i) => (
            <a href={`/news/${post.slug}`} class={`group no-underline block reveal reveal-d${Math.min(i + 1, 4)}`}>
              <div class="overflow-hidden mb-4">
                <img
                  src={post.image}
                  alt={post.imageAlt}
                  class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <span class="inline-block text-[0.6rem] font-semibold tracking-[0.15em] uppercase text-gold font-inter mb-2">
                {post.category}
              </span>
              <h3 class="font-playfair text-[1.15rem] font-bold text-navy-deep leading-[1.3] mb-2 group-hover:text-navy-mid transition-colors duration-200">
                {post.title}
              </h3>
              <p class="font-inter text-text-mid text-sm leading-relaxed mb-3 line-clamp-3">
                {post.excerpt}
              </p>
              <p class="font-inter text-xs text-text-mid">{formatDate(post.publishedAt)}</p>
            </a>
          ))}
        </div>

        {otherPosts.length === 0 && (
          <p class="font-inter text-text-mid text-sm">More posts coming soon.</p>
        )}

      </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="bg-navy-deep py-16 md:py-20 border-t border-[rgba(212,165,116,0.2)]">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center reveal">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-8 h-px bg-gold"></div>
              <p class="text-[0.7rem] font-semibold tracking-[0.18em] uppercase text-gold font-inter">Stay Connected</p>
            </div>
            <h2 class="font-playfair text-[1.75rem] md:text-[2.25rem] font-bold text-white mb-4 leading-[1.15]">Never miss an update.</h2>
            <p class="font-inter text-[rgba(255,255,255,0.8)] text-[0.95rem] leading-relaxed">
              Scholarship announcements, event news, and community stories delivered to your inbox.
            </p>
          </div>
          <div class="md:text-right">
            <a href="/contact" class="inline-block font-semibold uppercase tracking-[0.05em] no-underline transition-all relative overflow-hidden group/btn ease-out font-inter text-[#0f2942] border-2 border-[#d4a574] hover:text-[#0f2942] px-14 py-5 text-base">
              <span class="absolute inset-0 bg-[#d4a574]"></span>
              <span class="absolute inset-0 bg-[#0f2942] origin-left scale-x-0 group-hover/btn:scale-x-100 transition-transform duration-400 ease-out"></span>
              <span class="relative z-10 text-[#0f2942] group-hover/btn:text-white transition-colors duration-400">Get in Touch</span>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
