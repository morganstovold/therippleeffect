---
import { render } from "astro:content";
import ArrowLink from "../../components/ArrowLink.astro";
import Button from "../../components/Button.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Photo from "../../components/Photo.astro";
import PostCard from "../../components/PostCard.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getPosts } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: posts.filter((other) => other !== post).slice(0, 2) },
  }));
}

const { post, related } = Astro.props;
const { title, category, date, excerpt, image, imageAlt } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={excerpt} image={typeof image === "string" ? image : undefined}>
  <section class="relative overflow-hidden bg-navy-deep">
    <div class="relative z-10 mx-auto max-w-[900px] px-6 pt-24 pb-16 md:px-12 md:pt-32 md:pb-20">
      <div class="mb-8 flex items-center gap-4">
        <ArrowLink href="/news" direction="back" class="text-xs tracking-[0.1em] text-white/50 uppercase">
          News &amp; Stories
        </ArrowLink>
        <span class="border border-gold/40 px-3 py-1 text-[0.65rem] font-semibold tracking-[0.18em] text-gold uppercase">
          {category}
        </span>
      </div>
      <h1 class="mb-5 font-playfair text-[2rem] leading-[1.1] font-bold text-white md:text-[3rem] lg:text-[3.5rem]">
        {title}
      </h1>
      <p class="text-sm text-white/55">{formatDate(date)}</p>
    </div>
  </section>

  <article class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-[720px] px-6 md:px-12">
      <Photo
        src={image}
        alt={imageAlt}
        width={1200}
        sizes="(min-width: 768px) 720px, 100vw"
        priority
        class="mb-12 h-64 w-full object-cover md:h-80"
      />

      <div
        class="space-y-6 text-[1rem] leading-[1.85] text-text-mid md:text-[1.05rem] [&_a]:font-semibold [&_a]:text-navy-mid [&_a:hover]:text-gold"
      >
        <Content />
      </div>

      <div
        class="mt-12 flex flex-col gap-4 border-t border-navy-deep/10 pt-8 sm:flex-row sm:items-center sm:justify-between"
      >
        <ArrowLink href="/news" direction="back">Back to News</ArrowLink>
        <Button href="/get-involved" variant="gold" size="sm">Support the Foundation</Button>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="border-t border-navy-deep/8 bg-cream py-16 md:py-20">
        <div class="page-container">
          <Eyebrow class="mb-10">More Stories</Eyebrow>
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
            {related.map((other) => (
              <PostCard post={other} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
