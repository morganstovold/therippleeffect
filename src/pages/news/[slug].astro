---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Button from "../../components/Button.astro";
import { getPostBySlug, getRecentPosts, formatDate } from "../../data/posts";

// TODO: Replace with backend query:
//   const post = await db.posts.findUnique({ where: { slug: Astro.params.slug } });
const { slug } = Astro.params;
const post = getPostBySlug(slug ?? "");

if (!post) {
  return Astro.redirect("/news");
}

const related = getRecentPosts(3)
  .filter((p) => p.slug !== post.slug)
  .slice(0, 2);

// Convert plain text body to paragraphs
const paragraphs = post.body.split("\n\n").filter(Boolean);
---

<Layout
  title={`${post.title} | The Ripple Effect of Life`}
  description={post.excerpt}
>
  <Navbar />

  <main class="mt-[72px]">
    <!-- Article Header -->
    <section class="relative overflow-hidden bg-navy-deep">
      <div class="absolute inset-0 z-0">
        <img
          src={post.image}
          alt={post.imageAlt}
          class="w-full h-full object-cover opacity-20"
          loading="eager"
        >
        <div class="absolute inset-0 bg-navy-deep/80"></div>
      </div>
      <div
        class="relative z-10 max-w-[900px] mx-auto px-6 md:px-12 pt-24 pb-16 md:pt-32 md:pb-20"
      >
        <!-- Back nav + category badge: same flex row, vertically centered -->
        <div class="flex items-center gap-4 mb-8">
          <a
            href="/news"
            class="inline-flex items-center gap-2 font-inter text-xs font-semibold tracking-[0.1em] uppercase text-[rgba(255,255,255,0.5)] hover:text-gold transition-colors duration-200 no-underline"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
              />
            </svg>
            News &amp; Stories
          </a>
          <span
            class="inline-block text-[0.65rem] font-semibold tracking-[0.18em] uppercase text-gold font-inter border border-[rgba(212,165,116,0.4)] px-3 py-1"
          >
            {post.category}
          </span>
        </div>
        <h1
          class="font-playfair text-[2rem] md:text-[3rem] lg:text-[3.5rem] font-bold text-white leading-[1.1] mb-5"
        >
          {post.title}
        </h1>
        <p class="font-inter text-[rgba(255,255,255,0.55)] text-sm">
          {formatDate(post.publishedAt)}
        </p>
      </div>
    </section>

    <!-- Article Body -->
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-[720px] mx-auto px-6 md:px-12">
        <!-- Featured image -->
        <img
          src={post.image}
          alt={post.imageAlt}
          class="w-full h-64 md:h-80 object-cover mb-12"
          loading="lazy"
        >

        <!-- Body text -->
        <div class="prose-content">
          {paragraphs.map(para => (
            <p class="font-inter text-[1rem] md:text-[1.05rem] leading-[1.85] text-text-mid mb-6">
              {para}
            </p>
          ))}
        </div>

        <!-- Share / back -->
        <div
          class="border-t border-[rgba(15,41,66,0.1)] mt-12 pt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
        >
          <a
            href="/news"
            class="inline-flex items-center gap-2 font-inter text-sm font-semibold text-navy-mid hover:text-gold transition-colors duration-200 no-underline"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
              />
            </svg>
            Back to News
          </a>
          <Button href="/get-involved" variant="gold" size="sm">
            Support the Foundation
          </Button>
        </div>
      </div>
    </section>

    <!-- Related Posts -->
    {related.length > 0 && (
      <section class="bg-[#faf8f5] py-16 md:py-20 border-t border-[rgba(15,41,66,0.08)]">
        <div class="max-w-[1400px] mx-auto px-6 md:px-12">
          <div class="flex items-center gap-3 mb-10">
            <div class="w-8 h-px bg-gold"></div>
            <p class="text-[0.7rem] font-semibold tracking-[0.18em] uppercase text-gold-dark font-inter">More Stories</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {related.map(rp => (
              <a href={`/news/${rp.slug}`} class="group no-underline block">
                <div class="overflow-hidden mb-4">
                  <img
                    src={rp.image}
                    alt={rp.imageAlt}
                    class="w-full h-44 object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <span class="text-[0.6rem] font-semibold tracking-[0.15em] uppercase text-gold font-inter block mb-1">{rp.category}</span>
                <h3 class="font-playfair text-[1.15rem] font-bold text-navy-deep leading-[1.3] group-hover:text-navy-mid transition-colors duration-200">
                  {rp.title}
                </h3>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
