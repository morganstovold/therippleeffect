---
import Button from "../components/Button.astro";
import CallToAction from "../components/CallToAction.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SponsorMarquee from "../components/SponsorMarquee.astro";
import Layout from "../layouts/Layout.astro";
import { site } from "../site";

const moreWays = [
  {
    title: "Donate Sports Equipment",
    text: "Drop off new or gently used, game-ready gear for the Ripple Sports Closet. Porch drop-off anytime.",
    href: "/programs#sports-closet",
    label: "Ripple Sports Closet",
  },
  {
    title: "Join Summer of Service",
    text: "Kids and teens ages 5–18 serve, learn, move, and connect all summer, earning prize entries along the way.",
    href: "/programs#summer-of-service",
    label: "Summer of Service",
  },
  {
    title: "Come to an Event",
    text: "Walk with our team, play in our Golf Classic, or join us at our next community gathering.",
    href: "/events",
    label: "See Events",
  },
];

const donationLevels = [
  { amount: "$500", name: "Champion", text: "Funds a full scholarship award" },
  { amount: "$250", name: "Advocate", text: "Supports event programming" },
  { amount: "$100", name: "Supporter", text: "Provides student resources" },
  { amount: "$25", name: "Friend", text: "Contributes to community programs" },
];

const sponsorBenefits = [
  "Your business logo or family name on our Sponsors page",
  "Logo or name placement at our events",
  "Social media recognition and a thank-you",
  "Listing in event materials",
  "Connection to our mission-driven community",
];

const volunteerRoles = [
  { title: "Event Support", text: "Help run our Golf Classic and community programs from setup to wrap-up." },
  { title: "Mentorship", text: "Share your experience with scholarship students and young people in our community." },
  { title: "Community Outreach", text: "Help spread the word about our mission and grow the foundation's reach." },
];
---

<Layout
  title="Get Involved"
  description="Join us in making a difference. Donate, sponsor, volunteer, or partner with The Ripple Effect of Life nonprofit."
>
  <PageHeader
    eyebrow="Make a Difference"
    title="Get Involved"
    subtitle="Whether you give time, talent, or treasure, every contribution creates a ripple that transforms lives and strengthens our community."
  />

  <!-- Donate -->
  <Section tone="white" id="donate">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading eyebrow="Support Our Mission" title="Make a Donation" class="mb-8">
          <p>
            Your contribution directly funds our scholarships, community events, and service initiatives. Every dollar
            creates an opportunity for a student or neighbor who needs it most.
          </p>
        </SectionHeading>
        <div class="reveal">
          {
            site.donateUrl ? (
              <Button href={site.donateUrl} variant="gold">
                Donate Now
              </Button>
            ) : (
              <Button href="/contact" variant="gold">
                Contact Us to Donate
              </Button>
            )
          }
          <p class="mt-4 max-w-md text-sm text-text-mid">
            Donations go to the Ripple Effect of Life Fund at the {site.donationsReceivedBy.name}, a 501(c)(3) nonprofit
            (EIN {site.donationsReceivedBy.ein}). Gifts are tax-deductible to the extent allowed by law.
          </p>
        </div>
      </div>

      <ul class="reveal reveal-d1 grid grid-cols-2 gap-4">
        {
          donationLevels.map((level) => (
            <li class="border border-gold/30 bg-cream p-7 text-center">
              <p class="mb-2 font-playfair text-[2.5rem] text-gold-dark">{level.amount}</p>
              <p class="mb-1 font-playfair text-lg font-bold text-navy-deep">{level.name}</p>
              <p class="text-xs leading-relaxed text-text-mid">{level.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Sponsor -->
  <Section tone="cream" id="sponsor">
    <SectionHeading eyebrow="Businesses & Families" title="Sponsorship Opportunities" center>
      <p>
        Partner with The Ripple Effect of Life and align your brand with meaningful community impact. Sponsorships support
        our scholarship fund, community events, and year-round programs.
      </p>
    </SectionHeading>

    <div class="reveal mx-auto mb-12 max-w-3xl border-t-4 border-gold bg-navy-deep p-8 md:p-12">
      <h3 class="mb-6 font-playfair text-2xl font-bold text-white md:text-3xl">What Sponsors Receive</h3>
      <ul class="grid grid-cols-1 gap-x-8 gap-y-3 text-sm text-white/80 sm:grid-cols-2">
        {
          sponsorBenefits.map((benefit) => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5 shrink-0 text-gold" aria-hidden="true">
                ›
              </span>
              {benefit}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reveal text-center">
      <Button href="/contact" variant="gold" size="lg">Become a Sponsor</Button>
      <p class="mt-4 text-sm text-text-mid">
        Questions? Reach out at
        <a href={`mailto:${site.email}`} class="font-semibold text-gold-dark hover:underline">{site.email}</a>
      </p>
    </div>
  </Section>

  <!-- Current sponsors -->
  <section class="border-t border-navy-deep/8 bg-white py-16 md:py-20">
    <div class="page-container reveal mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <p class="font-playfair text-[1.5rem] font-bold text-navy-deep md:text-[1.75rem]">Join our generous sponsors</p>
      <a href="/sponsors" class="text-sm font-semibold text-navy-mid no-underline transition-colors hover:text-gold">
        See all sponsors →
      </a>
    </div>
    <SponsorMarquee />
  </section>

  <!-- Volunteer -->
  <Section tone="sand" id="volunteer">
    <SectionHeading eyebrow="Give Your Time" title="Volunteer" center>
      <p>
        Volunteers are the heart of The Ripple Effect of Life. Whether for a single event or an ongoing role, your time
        makes a real difference.
      </p>
    </SectionHeading>
    <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        volunteerRoles.map((role, i) => (
          <div class={`reveal reveal-d${i + 1} border-t-2 border-gold bg-white p-8`}>
            <h3 class="mb-3 font-playfair text-xl font-bold text-navy-deep">{role.title}</h3>
            <p class="text-sm leading-relaxed text-text-mid">{role.text}</p>
          </div>
        ))
      }
    </div>
    <div class="reveal text-center">
      <Button href="/contact">Contact Us to Volunteer</Button>
    </div>
  </Section>

  <!-- More ways -->
  <Section tone="white">
    <SectionHeading eyebrow="Every Ripple Matters" title="More Ways to Make Ripples" center />
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        moreWays.map((way, i) => (
          <div class={`reveal reveal-d${i + 1} flex flex-col border-t-2 border-gold bg-cream p-8`}>
            <h3 class="mb-3 font-playfair text-xl font-bold text-navy-deep">{way.title}</h3>
            <p class="mb-6 flex-1 text-sm leading-relaxed text-text-mid">{way.text}</p>
            <div>
              <Button href={way.href} size="sm">
                {way.label}
              </Button>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <CallToAction eyebrow="Together" title="Together, We Create Ripples">
    Your involvement creates lasting change. Join us in making a difference today.
    <Fragment slot="actions">
      <Button href="/contact" variant="gold">Contact Us</Button>
    </Fragment>
  </CallToAction>
</Layout>
