---
import Button from "../../components/Button.astro";
import CallToAction from "../../components/CallToAction.astro";
import EventCard from "../../components/EventCard.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import PageHeader from "../../components/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";
import { getEvents } from "../../lib/content";

// Rendered per request so events move from upcoming to past on their own.
export const prerender = false;

const { upcoming, past } = await getEvents();
---

<Layout
  title="Events"
  description="Community events from The Ripple Effect of Life foundation that bring people together in the spirit of service and generosity."
>
  <PageHeader
    eyebrow="Our Events"
    title="Events"
    subtitle="Community events that bring people together in the spirit of service and generosity."
  />

  <section class="bg-cream py-20 md:py-28">
    <div class="page-container space-y-12">
      <Eyebrow class="reveal">Upcoming</Eyebrow>
      {
        upcoming.length > 0 ? (
          upcoming.map((event) => <EventCard event={event} upcoming />)
        ) : (
          <p class="text-text-mid">New events will be announced soon. Check back or get in touch to hear first.</p>
        )
      }

      {
        past.length > 0 && (
          <>
            <Eyebrow class="reveal pt-8">Past Events</Eyebrow>
            {past.map((event) => (
              <EventCard event={event} upcoming={false} />
            ))}
          </>
        )
      }
    </div>
  </section>

  <CallToAction eyebrow="More Coming" title={`More Events in ${new Date().getFullYear()}`}>
    We're planning additional events throughout the year. Stay in touch to be the first to hear about new events.
    <Fragment slot="actions">
      <Button href="/contact" variant="gold">Stay Connected</Button>
    </Fragment>
  </CallToAction>
</Layout>
