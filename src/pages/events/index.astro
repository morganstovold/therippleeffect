---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import Button from '../../components/Button.astro';
---

<Layout title="Events | The Ripple Effect of Life" description="Upcoming events from The Ripple Effect of Life foundation, including the First Inaugural Golf Classic on May 28, 2026.">
  <Navbar />

  <main class="mt-[72px]">

    <PageHeader
      eyebrow="Our Events"
      title="Events"
      subtitle="Community events that bring people together in the spirit of service and generosity."
    />

    <!-- Upcoming Events -->
    <section class="bg-cream py-20 md:py-28">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">

        <div class="flex items-center gap-3 mb-12 reveal">
          <div class="w-8 h-px bg-gold"></div>
          <p class="text-[0.7rem] font-semibold tracking-[0.18em] uppercase text-gold-dark font-inter">Upcoming</p>
        </div>

        <!-- Golf Classic Card -->
        <div class="overflow-hidden border border-[rgba(15,41,66,0.12)] reveal">
          <!-- Photo header -->
          <div class="relative h-52 md:h-64 overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1535131749006-b7f58c99034b?auto=format&fit=crop&w=1600&q=80"
              alt="Golf course at Eagle Vines"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-navy-deep/65"></div>
            <div class="absolute inset-0 flex items-end p-6 md:p-8">
              <div class="flex items-center gap-3">
                <span class="text-[0.65rem] font-semibold tracking-[0.2em] uppercase text-gold font-inter bg-navy-deep/60 px-3 py-1.5">Golf Tournament</span>
                <span class="text-[0.65rem] font-semibold tracking-[0.2em] uppercase text-[rgba(255,255,255,0.7)] font-inter">May 28, 2026</span>
              </div>
            </div>
          </div>

          <!-- Content row -->
          <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr]">
            <!-- Date column -->
            <div class="bg-navy-deep p-8 md:p-10 flex flex-col justify-center items-center text-center border-r border-[rgba(212,165,116,0.2)]">
              <p class="font-inter text-[0.6rem] font-semibold tracking-[0.2em] uppercase text-gold mb-3">2026</p>
              <p class="font-playfair text-[2.5rem] font-bold text-white leading-none mb-0.5">May</p>
              <p class="font-playfair text-[3.5rem] font-bold text-white leading-none">28</p>
              <div class="w-6 h-px bg-gold mt-4"></div>
            </div>
            <!-- Content column -->
            <div class="p-8 md:p-10 border-l-4 border-gold bg-white">
              <h2 class="font-playfair text-[1.75rem] md:text-[2rem] font-bold text-navy-deep mb-2 leading-[1.2]">First Inaugural Golf Classic</h2>
              <p class="font-inter text-text-mid text-sm mb-1">Eagle Vines Vineyards &amp; Golf Club, American Canyon, CA</p>
              <p class="font-inter text-text-mid text-sm mb-6">Four Person Scramble &nbsp;&bull;&nbsp; $225 / individual &nbsp;&bull;&nbsp; $900 / foursome</p>
              <p class="font-inter text-text-mid text-[0.95rem] leading-relaxed mb-8 max-w-2xl">
                A day of golf, community, and giving in support of The Ripple Effect of Life. All proceeds benefit our scholarship fund and community programs.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <Button href="/events/golf-classic" variant="primary" size="sm">View Details</Button>
                <Button href="https://events.golfstatus.com/event/TheRippleEffect" variant="gold" size="sm">Register Now</Button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Stay Connected -->
    <section class="bg-navy-deep py-16 md:py-20 border-t border-[rgba(212,165,116,0.2)]">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center reveal">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-8 h-px bg-gold"></div>
              <p class="text-[0.7rem] font-semibold tracking-[0.18em] uppercase text-gold font-inter">More Coming</p>
            </div>
            <h2 class="font-playfair text-[1.75rem] md:text-[2.25rem] font-bold text-white mb-4 leading-[1.15]">More Events in 2026</h2>
            <p class="font-inter text-[rgba(255,255,255,0.8)] text-[0.95rem] leading-relaxed">
              We're planning additional events throughout the year. Stay in touch to be the first to hear about new events.
            </p>
          </div>
          <div class="md:text-right">
            <Button href="/contact" variant="gold" size="md">Stay Connected</Button>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
