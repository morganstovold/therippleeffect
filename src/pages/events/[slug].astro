---
import { getCollection, getEntry, render } from "astro:content";
import ArrowLink from "../../components/ArrowLink.astro";
import Button from "../../components/Button.astro";
import EventRecap from "../../components/EventRecap.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Photo from "../../components/Photo.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate, hasRecap, isUpcoming } from "../../lib/content";
import { site } from "../../site";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { title, date, tagline, headline, summary, venue, address, format, pricing, image, imageAlt, registrationUrl } =
  event.data;
const { Content } = await render(event);
const relatedPost = event.data.relatedPost && (await getEntry(event.data.relatedPost));
const upcoming = isUpcoming(event);
const labelClass = "mb-1 text-[0.7rem] font-semibold tracking-[0.12em] text-navy-mid uppercase";
---

<Layout title={title} description={summary}>
  <!-- Hero -->
  <section class="relative flex min-h-[480px] items-end overflow-hidden">
    <div class="absolute inset-0 z-0">
      <Photo src={image} alt={imageAlt} width={2000} priority class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-navy-deep/80"></div>
      <div class="absolute inset-0 bg-linear-to-t from-navy-deep/90 via-navy-deep/50 to-navy-deep/30"></div>
      <div class="absolute bottom-0 left-0 h-px w-full bg-linear-to-r from-transparent via-gold to-transparent"></div>
    </div>

    <div class="relative z-10 page-container pt-24 pb-16 md:pb-20">
      <ArrowLink href="/events" direction="back" class="mb-10 text-xs tracking-[0.1em] text-white/45 uppercase">
        All Events
      </ArrowLink>
      <Eyebrow tone="light" class="mb-3">{formatDate(date)}</Eyebrow>
      <h1 class="mb-4 font-playfair text-[2.25rem] leading-[1.05] font-bold text-white md:text-[3.25rem] lg:text-[4rem]">
        {title}
      </h1>
      <p class="max-w-xl text-[1rem] text-white/75 md:text-[1.1rem]">{tagline}</p>
    </div>
  </section>

  {!upcoming && hasRecap(event) && <EventRecap event={event} />}

  <!-- Overview -->
  <section class="bg-cream py-20 md:py-28">
    <div class="page-container grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal">
        <Eyebrow class="mb-3">Overview</Eyebrow>
        <h2 class="mb-5 font-playfair text-[2rem] leading-[1.15] font-bold text-navy-deep md:text-[2.5rem]">
          {headline}
        </h2>
        <div class="space-y-5 text-[1rem] leading-[1.85] text-text-mid">
          <Content />
        </div>
        {
          upcoming && (
            <div class="mt-8 flex flex-col gap-4 sm:flex-row">
              <Button href={registrationUrl} variant="gold">
                Register Now
              </Button>
              <Button href="/contact">Sponsorship Inquiries</Button>
            </div>
          )
        }
      </div>

      <div class="reveal reveal-d1 border-l-4 border-gold bg-white p-8 md:p-10">
        <h3 class="mb-8 font-playfair text-[1.5rem] font-bold text-navy-deep">Event Details</h3>
        <dl class="mb-10 space-y-6 text-navy-deep">
          <div>
            <dt class={labelClass}>Date</dt>
            <dd>{formatDate(date, { dateStyle: "full" })}</dd>
          </div>
          <div>
            <dt class={labelClass}>Location</dt>
            <dd>{venue}</dd>
            <dd class="text-sm text-text-mid">{address}</dd>
          </div>
          <div>
            <dt class={labelClass}>Format</dt>
            <dd>{format}</dd>
          </div>
          {
            pricing.length > 0 && (
              <div>
                <dt class={labelClass}>Pricing</dt>
                {pricing.map((price) => (
                  <dd class="mb-1">
                    <span class="text-[1.1rem] font-semibold">{price.amount}</span> {price.label}
                  </dd>
                ))}
              </div>
            )
          }
        </dl>
        {
          upcoming && (
            <div class="space-y-3">
              <Button href={registrationUrl} variant="gold" class="w-full text-center">
                Register Now
              </Button>
              <Button href="/contact" class="w-full text-center">
                Sponsorship Inquiries
              </Button>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- What to expect -->
  {
    event.data.highlights.length > 0 && (
      <section class="bg-navy-deep py-20 md:py-28">
        <div class="page-container">
          <div class="reveal mb-14 max-w-xl">
            <Eyebrow tone="light" class="mb-3">The Experience</Eyebrow>
            <h2 class="font-playfair text-[2rem] leading-[1.15] font-bold text-white md:text-[2.5rem]">{upcoming ? "What to Expect" : "The Day's Highlights"}</h2>
          </div>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
            {event.data.highlights.map((highlight, i) => (
              <div
                class={`reveal reveal-d${Math.min(i + 1, 4)} border-t-2 border-gold bg-white/5 p-7 transition-colors duration-300 hover:bg-white/8`}
              >
                <span class="mb-5 block font-playfair text-[2rem] leading-none font-bold text-gold opacity-35">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="mb-3 font-playfair text-[1.1rem] font-bold text-white">{highlight.title}</h3>
                <p class="text-sm leading-relaxed text-white/70">{highlight.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Related post -->
  {
    relatedPost && (
      <section class="border-t border-navy-deep/8 bg-cream py-16 md:py-20">
        <div class="page-container">
          <Eyebrow class="reveal mb-8">From the Blog</Eyebrow>
          <a
            href={`/news/${relatedPost.id}`}
            class="group reveal grid grid-cols-1 overflow-hidden border border-navy-deep/10 no-underline md:grid-cols-[320px_1fr]"
          >
            <div class="overflow-hidden">
              <Photo
                src={relatedPost.data.image}
                alt={relatedPost.data.imageAlt}
                width={800}
                sizes="(min-width: 768px) 320px, 100vw"
                class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-105 md:h-full"
              />
            </div>
            <div class="flex flex-col justify-center bg-white p-8 md:p-10">
              <span class="mb-2 block text-[0.6rem] font-semibold tracking-[0.15em] text-gold uppercase">
                {relatedPost.data.category}
              </span>
              <h3 class="mb-3 font-playfair text-[1.25rem] leading-[1.3] font-bold text-navy-deep transition-colors duration-200 group-hover:text-navy-mid md:text-[1.5rem]">
                {relatedPost.data.title}
              </h3>
              <p class="mb-4 text-sm leading-relaxed text-text-mid">{relatedPost.data.excerpt}</p>
              <span class="text-sm font-semibold text-navy-mid transition-colors duration-200 group-hover:text-gold">
                Read More →
              </span>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="border-t border-gold/20 bg-navy-deep py-16 md:py-20">
    <div class="reveal page-container text-center">
      <h2 class="mb-4 font-playfair text-[1.75rem] font-bold text-white md:text-[2.25rem]">
        {upcoming ? `Join Us on ${formatDate(date, { month: "long", day: "numeric" })}` : "Thank You for Joining Us"}
      </h2>
      <p class="mx-auto mb-8 max-w-md text-sm leading-relaxed text-white/65">
        Questions? Reach us at{" "}
        <a href={`mailto:${site.email}`} class="font-semibold text-gold transition-colors duration-200 hover:text-white">
          {site.email}
        </a>
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        {
          upcoming && (
            <Button href={registrationUrl} variant="gold">
              Register Now
            </Button>
          )
        }
        <Button href="/contact" variant="secondary">Contact Us</Button>
      </div>
    </div>
  </section>
</Layout>
