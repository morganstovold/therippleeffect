---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import { getEventBySlug } from '../../data/events';

// TODO: Replace with backend query:
//   const event = await db.events.findUnique({ where: { slug: Astro.params.slug } });
const { slug } = Astro.params;
const event = getEventBySlug(slug ?? '');

if (!event) {
  return Astro.redirect('/events');
}
---

<Layout
  title={`${event.title} | The Ripple Effect of Life`}
  description={event.description}
>
  <Navbar />

  <main class="mt-[72px]">

    <!-- Header -->
    <section class="relative overflow-hidden bg-navy-deep">
      <div class="absolute inset-0 z-0">
        <img
          src={event.image}
          alt={event.imageAlt}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-navy-deep/80"></div>
        <div class="absolute inset-0 bg-linear-to-r from-navy-deep/70 via-navy-deep/50 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full h-px bg-linear-to-r from-transparent via-gold to-transparent"></div>
      </div>
      <div class="relative z-10 max-w-[1400px] mx-auto px-6 md:px-12 pt-24 pb-16 md:pt-32 md:pb-20 w-full">
        <a href="/events" class="inline-flex items-center gap-2 font-inter text-xs font-semibold tracking-[0.1em] uppercase text-[rgba(255,255,255,0.45)] hover:text-gold transition-colors duration-200 no-underline mb-10 block">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
          All Events
        </a>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-px bg-gold"></div>
          <p class="text-[0.7rem] font-semibold tracking-[0.18em] uppercase text-gold font-inter">{event.eyebrow}</p>
        </div>
        <h1 class="font-playfair text-[2.25rem] md:text-[3rem] lg:text-[3.75rem] font-bold text-white leading-[1.1] mb-4">
          {event.title}
        </h1>
        <p class="font-inter text-[rgba(255,255,255,0.75)] text-[1rem] md:text-[1.1rem] max-w-xl">{event.subtitle}</p>
      </div>
    </section>

    <!-- Overview -->
    <section class="bg-[#faf8f5] py-20 md:py-28">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

          <!-- Description -->
          <div class="reveal">
            <h2 class="font-playfair text-[2rem] md:text-[2.5rem] font-bold text-navy-deep mb-5 leading-[1.15]">
              More than a tournament.
            </h2>
            <p class="font-inter text-[1rem] leading-[1.85] text-text-mid mb-5">
              {event.fullDescription}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 mt-8">
              <Button href={event.registrationUrl} variant="gold" size="md">Register Now</Button>
              <Button href="/contact" variant="primary" size="md">Sponsorship Inquiries</Button>
            </div>
          </div>

          <!-- Event Details Card -->
          <div class="bg-white border-l-4 border-gold p-8 md:p-10 reveal reveal-d1">
            <h3 class="font-playfair text-[1.5rem] font-bold text-navy-deep mb-8">Event Details</h3>

            <div class="space-y-6 mb-10">
              <div>
                <p class="font-inter text-[0.7rem] font-semibold tracking-[0.12em] uppercase text-navy-mid mb-1">Date</p>
                <p class="font-inter text-[1rem] text-navy-deep">{event.date}</p>
              </div>
              <div>
                <p class="font-inter text-[0.7rem] font-semibold tracking-[0.12em] uppercase text-navy-mid mb-1">Location</p>
                <p class="font-inter text-[1rem] text-navy-deep">{event.venue}</p>
                <p class="font-inter text-sm text-text-mid">{event.address}</p>
              </div>
              <div>
                <p class="font-inter text-[0.7rem] font-semibold tracking-[0.12em] uppercase text-navy-mid mb-1">Format</p>
                <p class="font-inter text-[1rem] text-navy-deep">{event.format}</p>
              </div>
              <div>
                <p class="font-inter text-[0.7rem] font-semibold tracking-[0.12em] uppercase text-navy-mid mb-1">Pricing</p>
                <p class="font-inter text-navy-deep mb-1"><span class="text-[1.1rem] font-semibold">{event.pricingIndividual}</span> per individual</p>
                <p class="font-inter text-navy-deep"><span class="text-[1.1rem] font-semibold">{event.pricingFoursome}</span> per foursome</p>
              </div>
            </div>

            <div class="space-y-3">
              <Button href={event.registrationUrl} variant="gold" size="md" class="w-full text-center">Register Now</Button>
              <Button href="/contact" variant="primary" size="md" class="w-full text-center">Sponsorship Inquiries</Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What to Expect -->
    <section class="bg-navy-deep py-20 md:py-28">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="max-w-xl mb-14 reveal">
          <p class="text-[0.75rem] font-semibold tracking-[0.15em] uppercase text-gold font-inter mb-3">The Experience</p>
          <h2 class="font-playfair text-[2rem] md:text-[2.5rem] font-bold text-white leading-[1.15]">What to Expect</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
          {event.features.map((feature, i) => (
            <div class={`bg-[rgba(255,255,255,0.05)] border-t-2 border-gold p-7 hover:bg-[rgba(255,255,255,0.08)] transition-colors duration-300 reveal reveal-d${Math.min(i + 1, 4)}`}>
              <span class="font-playfair text-[2rem] font-bold text-gold opacity-35 leading-none block mb-5">{feature.number}</span>
              <h3 class="font-playfair text-[1.1rem] font-bold text-white mb-3">{feature.title}</h3>
              <p class="font-inter text-[rgba(255,255,255,0.7)] text-sm leading-relaxed">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[#faf8f5] py-16 md:py-20 border-t border-[rgba(15,41,66,0.08)]">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12 text-center reveal">
        <h2 class="font-playfair text-[1.75rem] md:text-[2.25rem] font-bold text-navy-deep mb-4">Join Us on {event.month} {event.day}</h2>
        <p class="font-inter text-text-mid text-sm leading-relaxed mb-8 max-w-md mx-auto">
          Questions? Reach us at <a href="mailto:Info@TheRippleEffectOfLife.com" class="text-navy-mid font-semibold hover:text-gold transition-colors duration-200 no-underline">Info@TheRippleEffectOfLife.com</a>
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href={event.registrationUrl} variant="gold" size="md">Register Now</Button>
          <Button href="/contact" variant="primary" size="md">Contact Us</Button>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
