---
import LocalImage from "../components/LocalImage.astro";
import scholarshipLogo from "../assets/jb-community-service-scholarship.webp";
import Button from "../components/Button.astro";
import CallToAction from "../components/CallToAction.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ImpactStats from "../components/ImpactStats.astro";
import PageHeader from "../components/PageHeader.astro";
import Photo from "../components/Photo.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Layout from "../layouts/Layout.astro";
import { formatDate, getFeaturedEvent, getScholarships } from "../lib/content";

// Rendered per request so the application open/closed state follows the deadline.
export const prerender = false;

const featuredEvent = await getFeaturedEvent();

const { deadline, requirementsUrl, applicationUrl } = (await getScholarships())[0];
const applicationsOpen = deadline.getTime() >= Date.now();
const classYear = deadline.getUTCFullYear();

const criteria = [
  {
    title: "Graduating Benicia High School Senior",
    text: `Planning to graduate in ${classYear} and continue their education`,
  },
  {
    title: "College, Trade School, or Vocational Program",
    text: "Committed to continuing their education after graduation",
  },
  { title: "Demonstrated Community Service", text: "A meaningful record of giving back and positive impact" },
];
---

<Layout
  title="What We Do"
  description="The James Baldwin Community Service Scholarship and community events from The Ripple Effect of Life."
>
  <PageHeader
    eyebrow="What We Do"
    title="Programs & Impact"
    subtitle="Two core initiatives that carry James Baldwin's values of service, generosity, and community into the next generation."
  />

  <!-- Scholarship -->
  <Section tone="cream" id="scholarship">
    <div class="mb-16 grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal relative order-last lg:order-first">
        <div class="absolute -top-4 right-4 bottom-4 -left-4 border border-gold"></div>
        <div class="relative flex h-80 items-center justify-center bg-white p-8 lg:h-[420px]">
          <LocalImage src={scholarshipLogo} alt="James Baldwin Community Service Scholarship" class="max-h-full w-auto object-contain" />
        </div>
      </div>

      <div>
        <SectionHeading eyebrow="Scholarship" title="James Baldwin Community Service Scholarship" class="mb-8">
          <p>
            Awarded to Benicia High School seniors who embody James's spirit of service: students who show up for others,
            give back to their community, and carry that commitment into their future.
          </p>
        </SectionHeading>

        <ol class="reveal mb-10 space-y-4">
          {
            criteria.map((item, i) => (
              <li class="flex items-start gap-4">
                <span class="mt-0.5 shrink-0 font-playfair text-[1.5rem] leading-none font-bold text-gold-dark">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <p class="mb-1 text-sm font-semibold text-navy-deep">{item.title}</p>
                  <p class="text-sm leading-relaxed text-text-mid">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="reveal flex flex-col gap-4 sm:flex-row">
          <Button href={requirementsUrl} variant="gold">View Requirements</Button>
          {applicationsOpen && <Button href={applicationUrl}>Apply Now</Button>}
        </div>
      </div>
    </div>

    <div class="reveal flex flex-col gap-4 border-l-4 border-gold bg-sand p-6 sm:flex-row sm:items-center sm:justify-between">
      {
        applicationsOpen ? (
          <>
            <div>
              <p class="mb-1 text-xs font-semibold tracking-widest text-navy-mid uppercase">Application Deadline</p>
              <p class="font-playfair text-[1.5rem] font-bold text-navy-deep">{formatDate(deadline)}</p>
            </div>
            <Button href={applicationUrl} size="sm">
              Submit Application
            </Button>
          </>
        ) : (
          <>
            <div>
              <p class="mb-1 text-xs font-semibold tracking-widest text-navy-mid uppercase">Applications Closed</p>
              <p class="font-playfair text-[1.5rem] font-bold text-navy-deep">
                The next scholarship round will be announced soon.
              </p>
            </div>
            <Button href="/contact" size="sm">
              Ask a Question
            </Button>
          </>
        )
      }
    </div>
  </Section>

  <!-- Featured event -->
  {
    featuredEvent && (
      <section class="relative flex min-h-[560px] items-center overflow-hidden">
        <div class="absolute inset-0 z-0">
          <Photo
            src={featuredEvent.data.image}
            alt={featuredEvent.data.imageAlt}
            width={2000}
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-navy-deep/80" />
          <div class="absolute inset-0 bg-linear-to-r from-navy-deep/70 via-navy-deep/50 to-transparent" />
        </div>

        <div class="relative z-10 page-container grid grid-cols-1 items-center gap-12 py-20 md:py-28 lg:grid-cols-2 lg:gap-20">
          <SectionHeading eyebrow="Community Events" title={featuredEvent.data.title} tone="light" class="">
            <p>Beyond scholarships, we bring people together. {featuredEvent.data.tagline}</p>
            <div class="flex flex-col gap-4 pt-4 sm:flex-row">
              <Button href={`/events/${featuredEvent.id}`} variant="gold">
                View Details
              </Button>
              <Button href={featuredEvent.data.registrationUrl} variant="secondary">
                Register Now
              </Button>
            </div>
          </SectionHeading>

          <div class="reveal reveal-d1 border border-gold/30 bg-white/6 p-8 backdrop-blur-sm md:p-10">
            <p class="mb-4 text-[0.65rem] font-semibold tracking-[0.2em] text-gold uppercase">Save the Date</p>
            <p class="mb-1 font-playfair text-[3.5rem] leading-none font-bold text-white">
              {formatDate(featuredEvent.data.date, { month: "short", day: "numeric" })}
            </p>
            <p class="mb-6 font-playfair text-xl text-white/60">
              {formatDate(featuredEvent.data.date, { year: "numeric" })}
            </p>
            <div class="mb-6 h-px w-8 bg-gold" />
            <div class="space-y-3 text-sm">
              <p class="text-white/85">{featuredEvent.data.venue}</p>
              <p class="text-white/65">{featuredEvent.data.city}</p>
              <p class="text-white/85">{featuredEvent.data.format}</p>
              {featuredEvent.data.pricing.length > 0 && (
                <p class="text-white/65">
                  {featuredEvent.data.pricing.map((price) => `${price.amount} ${price.label}`).join(" • ")}
                </p>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    !featuredEvent && (
      <Section tone="navy">
        <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-[3fr_2fr]">
          <SectionHeading eyebrow="Community Events" title="Bringing People Together" tone="light" class="">
            <p>
              Beyond scholarships, we host community events that celebrate James's legacy and raise the funds that sustain
              the foundation's work for years to come.
            </p>
          </SectionHeading>
          <div class="reveal flex flex-col gap-4 sm:flex-row md:justify-end">
            <Button href="/events" variant="gold">
              See Our Events
            </Button>
          </div>
        </div>
      </Section>
    )
  }

  <!-- Impact -->
  <Section tone="cream" compact class="border-t border-navy-deep/8">
    <Eyebrow class="reveal mb-10">Our Ripple</Eyebrow>
    <ImpactStats />
  </Section>

  <CallToAction eyebrow="Support the Work" title="Make a Difference">
    Every donation, volunteer hour, and event registration helps fund scholarships and sustain community programs built on
    James Baldwin's values.
    <Fragment slot="actions">
      <Button href="/get-involved#donate" variant="gold">Donate</Button>
      <Button href="/get-involved#volunteer" variant="secondary">Volunteer</Button>
    </Fragment>
  </CallToAction>
</Layout>
