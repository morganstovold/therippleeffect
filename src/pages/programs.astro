---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import scholarshipImage from '../assets/jb-community-service-scholarship.png';
---

<Layout title="What We Do - Programs" description="Explore The Ripple Effect of Life's scholarship, community events, and service initiatives.">
  <Navbar />

  <main class="mt-[90px]">
    <!-- Page Header -->
    <PageHeader
      eyebrow="Our Work"
      title="What We Do"
      subtitle="Through scholarships, community events, and service initiatives, we create opportunities and empower the next generation."
    />

    <!-- Programs Overview -->
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-6">
          <!-- Scholarships Card - Featured -->
          <div class="md:col-span-2">
            <div class="bg-gradient-to-br from-[#faf8f5] to-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 h-full flex flex-col">
              <div class="relative overflow-hidden h-64 md:h-72">
                <img
                  src={scholarshipImage.src}
                  alt="James Baldwin Community Service Scholarship"
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="p-8 md:p-10 flex flex-col flex-grow">
                <h3 class="font-playfair text-3xl md:text-4xl font-bold text-[#0f2942] mb-3">
                  James Baldwin Community Service Scholarship
                </h3>
                <p class="text-[#4a5568] font-inter text-lg mb-6 leading-relaxed flex-grow">
                  Recognizing Benicia High School seniors who embody James's spirit of service, leadership, and commitment to creating positive change in our community.
                </p>

                <div class="mb-8">
                  <h4 class="font-playfair text-xl font-bold text-[#0f2942] mb-4">Eligibility:</h4>
                  <ul class="space-y-3 text-[#4a5568] font-inter">
                    <li class="flex items-start">
                      <span class="text-[#d4a574] font-bold mr-3 flex-shrink-0">•</span>
                      <span>Graduating senior from Benicia High School</span>
                    </li>
                    <li class="flex items-start">
                      <span class="text-[#d4a574] font-bold mr-3 flex-shrink-0">•</span>
                      <span>Plans to attend college, trade school, or vocational program</span>
                    </li>
                    <li class="flex items-start">
                      <span class="text-[#d4a574] font-bold mr-3 flex-shrink-0">•</span>
                      <span>Demonstrated record of community service</span>
                    </li>
                    <li class="flex items-start">
                      <span class="text-[#d4a574] font-bold mr-3 flex-shrink-0">•</span>
                      <span>Committed to making a positive impact</span>
                    </li>
                  </ul>
                </div>

                <div class="bg-[#faf8f5] rounded-lg p-4 mb-8">
                  <p class="font-inter text-sm text-[#0f2942]">
                    <span class="font-bold">Application Deadline:</span> April 10, 2026
                  </p>
                </div>

                <div class="flex flex-col sm:flex-row gap-4">
                  <Button
                    href="https://eddy.pro/pdf/6456025"
                    variant="primary"
                    size="md"
                    class="flex-1"
                  >
                    View Requirements
                  </Button>
                  <Button
                    href="https://docs.google.com/forms/d/e/1FAIpQLSdE0oa_clmnhxRFj-iP0x1RHW1Pb5UXXuDM82MnU89XUeWebg/viewform"
                    variant="secondary"
                    size="md"
                    class="flex-1 bg-[#d4a574] hover:bg-[#8a5e2a] text-white"
                  >
                    Apply Now
                  </Button>
                </div>
              </div>
            </div>
          </div>

          <!-- Side Programs -->
          <div class="space-y-6">
            <!-- Community Events Card -->
            <div class="bg-gradient-to-br from-[#1a3a52] to-[#0f2942] rounded-lg p-8 text-white shadow-lg hover:shadow-xl transition-shadow duration-300">
              <h3 class="font-playfair text-2xl font-bold mb-4">Community Events</h3>
              <p class="font-inter text-[#faf8f5] mb-6 leading-relaxed">
                Bringing people together through meaningful events that celebrate community, foster connection, and support our mission.
              </p>

              <div class="bg-[#2d5f8d] rounded-lg p-4 mb-6">
                <p class="font-playfair text-lg font-bold text-[#d4a574] mb-2">First Inaugural Golf Classic</p>
                <p class="font-inter text-sm text-[#faf8f5]">May 28, 2026</p>
              </div>

              <Button
                href="/golf-classic"
                variant="secondary"
                size="sm"
                class="w-full bg-[#d4a574] hover:bg-[#8a5e2a] text-[#0f2942] font-bold"
              >
                Golf Classic Details
              </Button>
            </div>

            <!-- Community Service Card -->
            <div class="bg-gradient-to-br from-[#d4a574] to-[#8a5e2a] rounded-lg p-8 text-[#0f2942] shadow-lg hover:shadow-xl transition-shadow duration-300">
              <h3 class="font-playfair text-2xl font-bold mb-4">Community Service & Giving Back</h3>
              <p class="font-inter text-[#1a1a1a] mb-6 leading-relaxed">
                Join our volunteer initiatives and community partnerships to make a direct impact in Benicia and beyond.
              </p>

              <Button
                href="/get-involved"
                variant="primary"
                size="sm"
                class="w-full bg-[#0f2942] hover:bg-[#1a3a52] text-white font-bold"
              >
                Get Involved
              </Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Scholarship Detail Section -->
    <section id="scholarship" class="bg-[#0f2942] text-white py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
          <!-- Main Content -->
          <div class="lg:col-span-2">
            <div class="mb-6">
              <p class="font-inter text-sm uppercase tracking-widest text-[#d4a574] font-bold">
                Continuing the Legacy
              </p>
            </div>

            <h2 class="font-playfair text-4xl md:text-5xl font-bold mb-8 text-white">
              The Scholarship
            </h2>

            <p class="font-inter text-lg text-[#faf8f5] mb-8 leading-relaxed">
              The James Baldwin Community Service Scholarship honors his legacy of courage, integrity, and unwavering commitment to community. We seek students who share his passion for creating a more just and compassionate world.
            </p>

            <p class="font-inter text-lg text-[#faf8f5] mb-10 leading-relaxed">
              This scholarship recognizes and supports Benicia High School seniors who demonstrate exceptional community service, academic achievement, and dedication to making a positive impact—qualities that defined James's life and continue to inspire our work.
            </p>

            <div class="space-y-8">
              <h3 class="font-playfair text-2xl font-bold text-white">Eligibility Criteria</h3>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Criterion 1 -->
                <div class="flex gap-4">
                  <div class="flex-shrink-0">
                    <span class="font-playfair text-4xl font-bold text-[#d4a574]">01</span>
                  </div>
                  <div>
                    <h4 class="font-playfair text-xl font-bold text-white mb-2">Graduating Senior</h4>
                    <p class="font-inter text-[#faf8f5] leading-relaxed">
                      Currently a senior at Benicia High School planning to graduate in 2026
                    </p>
                  </div>
                </div>

                <!-- Criterion 2 -->
                <div class="flex gap-4">
                  <div class="flex-shrink-0">
                    <span class="font-playfair text-4xl font-bold text-[#d4a574]">02</span>
                  </div>
                  <div>
                    <h4 class="font-playfair text-xl font-bold text-white mb-2">Future Plans</h4>
                    <p class="font-inter text-[#faf8f5] leading-relaxed">
                      Committed to attending college, trade school, or vocational program
                    </p>
                  </div>
                </div>

                <!-- Criterion 3 -->
                <div class="flex gap-4">
                  <div class="flex-shrink-0">
                    <span class="font-playfair text-4xl font-bold text-[#d4a574]">03</span>
                  </div>
                  <div>
                    <h4 class="font-playfair text-xl font-bold text-white mb-2">Service Record</h4>
                    <p class="font-inter text-[#faf8f5] leading-relaxed">
                      Demonstrated meaningful involvement in community service and volunteer work
                    </p>
                  </div>
                </div>

                <!-- Criterion 4 -->
                <div class="flex gap-4">
                  <div class="flex-shrink-0">
                    <span class="font-playfair text-4xl font-bold text-[#d4a574]">04</span>
                  </div>
                  <div>
                    <h4 class="font-playfair text-xl font-bold text-white mb-2">Commitment to Impact</h4>
                    <p class="font-inter text-[#faf8f5] leading-relaxed">
                      Dedicated to creating positive change in your community and beyond
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar Card -->
          <div class="lg:col-span-1">
            <div class="sticky top-32 bg-[#d4a574] rounded-lg p-8 shadow-xl">
              <h4 class="font-playfair text-2xl font-bold text-[#0f2942] mb-2">Application Deadline</h4>
              <p class="font-playfair text-5xl font-bold text-[#0f2942] mb-8">April 10th</p>
              <p class="font-inter text-sm text-[#0f2942] mb-8 font-semibold">2026</p>

              <Button
                href="https://docs.google.com/forms/d/e/1FAIpQLSdE0oa_clmnhxRFj-iP0x1RHW1Pb5UXXuDM82MnU89XUeWebg/viewform"
                variant="primary"
                size="md"
                class="w-full bg-[#0f2942] hover:bg-[#1a3a52] text-white font-bold"
              >
                Submit Application
              </Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Upcoming Events Preview -->
    <section class="bg-[#faf8f5] py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-playfair text-4xl md:text-5xl font-bold text-[#0f2942] mb-12">Upcoming Events</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Golf Classic Event Card -->
          <div class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
            <div class="h-48 bg-gradient-to-br from-[#1a3a52] to-[#0f2942] flex items-center justify-center">
              <div class="text-center text-white">
                <p class="font-playfair text-5xl font-bold text-[#d4a574]">May 28</p>
                <p class="font-inter text-sm uppercase tracking-widest mt-2">2026</p>
              </div>
            </div>
            <div class="p-8">
              <h3 class="font-playfair text-2xl font-bold text-[#0f2942] mb-3">
                First Inaugural Golf Classic
              </h3>
              <p class="font-inter text-[#4a5568] mb-6 leading-relaxed">
                Join us for a day of golf, community, and camaraderie in support of The Ripple Effect of Life. A portion of all proceeds benefit our scholarship fund and community initiatives.
              </p>

              <div class="space-y-3 mb-6">
                <div class="flex items-start gap-3">
                  <span class="text-[#d4a574] font-bold">📍</span>
                  <p class="font-inter text-[#4a5568]">Benicia Golf Course</p>
                </div>
                <div class="flex items-start gap-3">
                  <span class="text-[#d4a574] font-bold">⏰</span>
                  <p class="font-inter text-[#4a5568]">8:00 AM - 4:00 PM</p>
                </div>
              </div>

              <Button
                href="/golf-classic"
                variant="primary"
                size="md"
                class="w-full"
              >
                Learn More
              </Button>
            </div>
          </div>

          <!-- Placeholder for Future Events -->
          <div class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300 flex items-center justify-center min-h-[400px]">
            <div class="text-center p-8">
              <p class="font-playfair text-2xl font-bold text-[#0f2942] mb-4">More Events Coming Soon</p>
              <p class="font-inter text-[#4a5568] mb-6">
                We're planning exciting events throughout the year. Check back soon for updates!
              </p>
              <Button
                href="/get-involved"
                variant="secondary"
                size="md"
                class="inline-block bg-[#d4a574] hover:bg-[#8a5e2a] text-white"
              >
                Get Involved
              </Button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
