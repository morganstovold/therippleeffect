---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import Button from "../components/Button.astro";
import scholarshipLogo from "../assets/jb-community-service-scholarship.png";
import { Image } from "astro:assets";
---

<Layout
  title="What We Do | The Ripple Effect of Life"
  description="The James Baldwin Community Service Scholarship and community events from The Ripple Effect of Life."
>
  <Navbar />

  <main class="mt-[72px]">
    <PageHeader
      eyebrow="What We Do"
      title="Programs & Impact"
      subtitle="Two core initiatives that carry James Baldwin's values of service, generosity, and community into the next generation."
    />

    <!-- Scholarship -->
    <section class="bg-cream py-20 md:py-32">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center mb-16"
        >
          <!-- Scholarship image -->
          <div class="relative order-last lg:order-first reveal">
            <div
              class="absolute -top-4 -left-4 right-4 bottom-4 border border-gold -z-10"
            ></div>
            <Image
              src={scholarshipLogo}
              alt="Scholarship"
              class="w-full h-80 lg:h-[420px] object-cover"
              loading="lazy"
            />
          </div>

          <div class="reveal reveal-d1">
            <p
              class="text-[0.75rem] font-semibold tracking-[0.15em] uppercase text-gold font-inter mb-5"
            >
              Scholarship
            </p>
            <h2
              class="text-[2rem] md:text-[2.75rem] font-bold text-navy-deep leading-[1.15] font-playfair mb-6"
            >
              James Baldwin Community Service Scholarship
            </h2>
            <p
              class="text-[1rem] leading-[1.8] text-text-mid font-light font-inter mb-8"
            >
              Awarded to Benicia High School seniors who embody James's spirit
              of service: students who show up for others, give back to their
              community, and carry that commitment into their future.
            </p>

            <div class="space-y-4 mb-10">
              <div class="flex gap-4 items-start">
                <span
                  class="font-playfair text-[1.5rem] font-bold text-gold leading-none opacity-40 shrink-0 mt-0.5"
                  >01</span
                >
                <div>
                  <p
                    class="font-inter text-sm font-semibold text-navy-deep mb-1"
                  >
                    Graduating Benicia High School Senior
                  </p>
                  <p class="font-inter text-sm text-text-mid leading-relaxed">
                    Planning to graduate in 2026 and continue their education
                  </p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <span
                  class="font-playfair text-[1.5rem] font-bold text-gold leading-none opacity-40 shrink-0 mt-0.5"
                  >02</span
                >
                <div>
                  <p
                    class="font-inter text-sm font-semibold text-navy-deep mb-1"
                  >
                    College, Trade School, or Vocational Program
                  </p>
                  <p class="font-inter text-sm text-text-mid leading-relaxed">
                    Committed to continuing their education after graduation
                  </p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <span
                  class="font-playfair text-[1.5rem] font-bold text-gold leading-none opacity-40 shrink-0 mt-0.5"
                  >03</span
                >
                <div>
                  <p
                    class="font-inter text-sm font-semibold text-navy-deep mb-1"
                  >
                    Demonstrated Community Service
                  </p>
                  <p class="font-inter text-sm text-text-mid leading-relaxed">
                    A meaningful record of giving back and positive impact
                  </p>
                </div>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4">
              <Button
                href="https://eddy.pro/pdf/6456025"
                variant="gold"
                size="md"
              >
                View Requirements
              </Button>
              <Button
                href="https://docs.google.com/forms/d/e/1FAIpQLSdE0oa_clmnhxRFj-iP0x1RHW1Pb5UXXuDM82MnU89XUeWebg/viewform"
                variant="primary"
                size="md"
              >
                Apply Now
              </Button>
            </div>
          </div>
        </div>

        <!-- Deadline Banner -->
        <div
          class="border-l-4 border-gold bg-[#f7f5f2] p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
        >
          <div>
            <p
              class="font-inter text-xs font-semibold uppercase tracking-widest text-navy-mid mb-1"
            >
              Application Deadline
            </p>
            <p class="font-playfair text-[1.5rem] font-bold text-navy-deep">
              April 10, 2026
            </p>
          </div>
          <Button
            href="https://docs.google.com/forms/d/e/1FAIpQLSdE0oa_clmnhxRFj-iP0x1RHW1Pb5UXXuDM82MnU89XUeWebg/viewform"
            variant="primary"
            size="sm"
          >
            Submit Application
          </Button>
        </div>
      </div>
    </section>

    <!-- Golf Classic: Full-width photo section -->
    <section class="relative min-h-[560px] flex items-center overflow-hidden">
      <!-- Background photo -->
      <div class="absolute inset-0 z-0">
        <img
          src="https://images.unsplash.com/photo-1535131749006-b7f58c99034b?auto=format&fit=crop&w=1920&q=80"
          alt="Golf course"
          class="w-full h-full object-cover"
          loading="lazy"
        >
        <div class="absolute inset-0 bg-navy-deep/80"></div>
        <div
          class="absolute inset-0 bg-linear-to-r from-navy-deep/70 via-navy-deep/50 to-transparent"
        ></div>
      </div>

      <div
        class="relative z-10 max-w-[1400px] mx-auto px-6 md:px-12 py-20 md:py-28 w-full"
      >
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
        >
          <div class="reveal">
            <p
              class="text-[0.75rem] font-semibold tracking-[0.15em] uppercase text-gold font-inter mb-3"
            >
              Community Events
            </p>
            <h2
              class="text-[2rem] md:text-[2.75rem] font-bold text-white leading-[1.15] font-playfair mb-5"
            >
              First Inaugural Golf Classic
            </h2>
            <p
              class="text-[1rem] leading-[1.85] text-[rgba(255,255,255,0.85)] font-inter mb-8"
            >
              Beyond scholarships, we bring people together. Our inaugural Golf
              Classic on May 28, 2026 celebrates community, honors James's
              legacy, and raises funds that sustain the foundation's work for
              years to come.
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              <Button href="/events/golf-classic" variant="gold" size="md">
                View Details
              </Button>
              <Button
                href="https://events.golfstatus.com/event/TheRippleEffect"
                variant="secondary"
                size="md"
              >
                Register Now
              </Button>
            </div>
          </div>

          <div class="reveal reveal-d1">
            <div
              class="border border-[rgba(212,165,116,0.3)] bg-[rgba(255,255,255,0.06)] backdrop-blur-sm p-8 md:p-10"
            >
              <p
                class="font-inter text-[0.65rem] font-semibold tracking-[0.2em] uppercase text-gold mb-4"
              >
                Save the Date
              </p>
              <p
                class="font-playfair text-[3.5rem] font-bold text-white leading-none mb-1"
              >
                May 28
              </p>
              <p
                class="font-playfair text-xl text-[rgba(255,255,255,0.6)] mb-6"
              >
                2026
              </p>
              <div class="w-8 h-px bg-gold mb-6"></div>
              <div class="space-y-3 text-sm font-inter">
                <p class="text-[rgba(255,255,255,0.85)]">
                  Eagle Vines Vineyards &amp; Golf Club
                </p>
                <p class="text-[rgba(255,255,255,0.65)]">American Canyon, CA</p>
                <p class="text-[rgba(255,255,255,0.85)]">
                  Four Person Scramble
                </p>
                <p class="text-[rgba(255,255,255,0.65)]">
                  $225 individual &nbsp;&bull;&nbsp; $900 foursome
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Get Involved CTA -->
    <section
      class="bg-cream py-16 md:py-20 border-t border-[rgba(15,41,66,0.08)]"
    >
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
          <div>
            <p
              class="text-[0.75rem] font-semibold tracking-[0.15em] uppercase text-gold font-inter mb-4"
            >
              Support the Work
            </p>
            <h2
              class="font-playfair text-[1.75rem] md:text-[2.25rem] font-bold text-navy-deep mb-4 leading-[1.15]"
            >
              Make a Difference
            </h2>
            <p class="font-inter text-text-mid text-[0.95rem] leading-relaxed">
              Every donation, volunteer hour, and event registration helps fund
              scholarships and sustain community programs built on James
              Baldwin's values.
            </p>
          </div>
          <div
            class="md:text-right flex flex-col sm:flex-row md:justify-end gap-4"
          >
            <Button href="/get-involved" variant="gold" size="md">
              Donate
            </Button>
            <Button href="/get-involved#volunteer" variant="primary" size="md">
              Volunteer
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
