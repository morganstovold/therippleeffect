---
import { getCollection } from "astro:content";
import Button from "../components/Button.astro";
import CallToAction from "../components/CallToAction.astro";
import PageHeader from "../components/PageHeader.astro";
import Photo from "../components/Photo.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Layout from "../layouts/Layout.astro";

const board = (await getCollection("board")).toSorted((a, b) => a.data.order - b.data.order);
const initials = (name: string) =>
  name
    .split(" ")
    .map((part) => part[0])
    .join("");
---

<Layout
  title="About Us"
  description="Kelly Baldwin and Terry Baldwin created The Ripple Effect of Life to honor James Baldwin, a lifelong community leader in Benicia, California."
>
  <PageHeader
    eyebrow="Our Story"
    title="About The Ripple Effect of Life"
    subtitle="Founded by Kelly Baldwin and Terry Baldwin in honor of a man whose life of service has shaped an entire community."
  />

  <!-- Founding story -->
  <Section tone="cream">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <SectionHeading eyebrow="Why This Foundation Exists" title="A Family's Tribute" class="">
        <p>
          Kelly Baldwin and her mother Terry Baldwin created The Ripple Effect of Life to honor James Baldwin: husband,
          father, and lifelong servant of his community. Together, they have watched firsthand the way he has shown up for
          others: coaching youth sports, mentoring young people, organizing community events, and giving freely of his
          time without expectation of recognition.
        </p>
        <p>
          This foundation is built on that same principle: that the kindness one person shows creates ripples far beyond
          what any of us can measure. Through scholarships and community events, The Ripple Effect of Life carries that
          spirit forward, ensuring James's legacy of service inspires future generations.
        </p>
      </SectionHeading>
      <div class="reveal reveal-d1">
        <Photo
          src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622"
          alt="Community gathering"
          width={900}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="h-80 w-full object-cover lg:h-[420px]"
        />
      </div>
    </div>
  </Section>

  <!-- James -->
  <Section tone="navy" id="james">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal relative">
        <div class="absolute -top-4 right-4 bottom-4 -left-4 border border-gold/40"></div>
        <Photo
          src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac"
          alt="Community"
          width={900}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="relative h-80 w-full object-cover lg:h-[460px]"
        />
      </div>
      <SectionHeading eyebrow="The Man" title="James Baldwin" tone="light" class="reveal-d1">
        <p>
          James Baldwin is a lifelong community leader in Benicia, California. For decades, he has dedicated himself to the
          people around him: coaching youth sports, mentoring young men and women, and organizing community events that
          bring neighbors together.
        </p>
        <p>
          What defines James is not grand gestures, but consistency. He shows up. He listens. He gives his time. Year after
          year, person after person, James has quietly shaped the fabric of his community in ways that are hard to fully
          capture, but impossible to miss when you've been on the receiving end of his generosity.
        </p>
        <p>
          The Ripple Effect of Life exists because of him, and because of the belief that his example is worth honoring and
          continuing.
        </p>
      </SectionHeading>
    </div>
  </Section>

  <!-- Mission -->
  <Section tone="cream">
    <SectionHeading eyebrow="Our Mission" title="What We Stand For" center class="">
      <p>
        We believe that one person's commitment to service can change a community. Through scholarships, community events,
        and initiatives that bring people together, we work to ensure that James Baldwin's values of generosity,
        mentorship, and service continue to take root in the next generation.
      </p>
      <p>
        Every scholarship awarded, every event organized, every volunteer hour given: these are ripples. And ripples
        spread.
      </p>
    </SectionHeading>
  </Section>

  <!-- Board -->
  <Section tone="navy">
    <SectionHeading eyebrow="Leadership" title="Our Board" tone="light" />
    <div class="mb-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        board.map(({ data: member }, i) => (
          <div class={`reveal reveal-d${Math.min(i + 1, 4)} border border-gold/15 bg-white/5 p-8`}>
            {member.photo ? (
              <Photo
                src={member.photo}
                alt={member.name}
                width={128}
                class="mb-5 size-16 rounded-full border border-gold/30 object-cover"
              />
            ) : (
              <div class="mb-5 flex size-16 items-center justify-center border border-gold/30 bg-gold/15">
                <span class="font-playfair text-xl font-bold text-gold">{initials(member.name)}</span>
              </div>
            )}
            <h3 class="mb-1 font-playfair text-[1.15rem] font-bold text-white">{member.name}</h3>
            <p class="mb-4 text-[0.75rem] font-semibold tracking-[0.08em] text-gold uppercase">{member.role}</p>
            <p class="text-sm leading-relaxed text-white/70">{member.bio}</p>
          </div>
        ))
      }
    </div>
    <div class="reveal flex flex-col gap-4 border-t border-gold/15 pt-10 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-white/60">Interested in supporting the foundation's leadership?</p>
      <Button href="/contact" variant="secondary" size="sm">Get in Touch</Button>
    </div>
  </Section>

  <CallToAction eyebrow="Join Us" title="Be Part of the Legacy">
    Join us in honoring James Baldwin's life of service through donations and community involvement.
    <Fragment slot="actions">
      <Button href="/get-involved" variant="gold">Get Involved</Button>
    </Fragment>
  </CallToAction>
</Layout>
