---
import { getCollection } from "astro:content";
import Button from "../components/Button.astro";
import CallToAction from "../components/CallToAction.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PageHeader from "../components/PageHeader.astro";
import Photo from "../components/Photo.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Layout from "../layouts/Layout.astro";

const board = (await getCollection("board")).toSorted((a, b) => a.data.order - b.data.order);
const initials = (name: string) =>
  name
    .split(" ")
    .map((part) => part[0])
    .join("");
---

<Layout
  title="About Us"
  description="The story of The Ripple Effect of Life, founded in February 2026 by Terry and Kelly Baldwin to honor James Baldwin, a lifelong community leader in Benicia, California."
>
  <PageHeader
    eyebrow="Our Story"
    title="About The Ripple Effect of Life"
    subtitle="Founded in February 2026 by Terry and Kelly Baldwin in honor of a man whose life of service has shaped an entire community."
  />

  <!-- Founding story -->
  <Section tone="cream">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <SectionHeading eyebrow="Our Story" title="How It Began" class="">
        <p>
          The Ripple Effect of Life was founded in February 2026 from a deeply personal journey and a desire to honor a man
          who has spent his entire life serving others.
        </p>
        <p>
          In October 2022, James Baldwin was diagnosed with kidney cancer. As his journey unfolded, our family was faced
          with difficult conversations and an uncertain future. Through it all, one thing became abundantly clear: the
          impact of a life dedicated to helping others cannot be measured by circumstances. It is measured by the lives
          touched along the way.
        </p>
      </SectionHeading>
      <div class="reveal reveal-d1">
        <Photo
          src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622"
          alt="Community gathering"
          width={900}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="h-80 w-full object-cover lg:h-[420px]"
        />
      </div>
    </div>
  </Section>

  <!-- James -->
  <Section tone="navy" id="james">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal relative">
        <div class="absolute -top-4 right-4 bottom-4 -left-4 border border-gold/40"></div>
        <Photo
          src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac"
          alt="Community"
          width={900}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="relative h-80 w-full object-cover lg:h-[460px]"
        />
      </div>
      <SectionHeading eyebrow="The Man" title="James Baldwin" tone="light" class="reveal-d1">
        <p>
          For decades, James has been a pillar of the Benicia community. Through countless hours of volunteerism,
          mentorship, service organizations, community projects, and simply being there when someone needed a helping
          hand, he has lived a life centered on giving back. His belief has always been that even the smallest act of
          kindness can create a ripple that extends far beyond what we can see.
        </p>
        <p>
          During his cancer journey, our family experienced those ripples firsthand. Friends, neighbors, local
          organizations, service clubs, and community members surrounded us with support, encouragement, and compassion.
          We witnessed the power of community and were reminded that when people come together with a shared purpose,
          incredible things can happen.
        </p>
      </SectionHeading>
    </div>
  </Section>

  <!-- Mission -->
  <Section tone="cream">
    <SectionHeading eyebrow="Our Mission" title="Be the Ripple. Create the Change." center>
      <p>
        Inspired by James' lifelong commitment to service and the support our family received, Terry Baldwin and Kelly
        Baldwin founded The Ripple Effect of Life in February 2026. Our mission is simple: to create opportunities, inspire
        service, and support individuals and families in ways that create lasting impact for generations to come.
      </p>
      <p>
        Today, The Ripple Effect of Life helps fund high school scholarships through the James Baldwin Community Service
        Scholarship, supports students pursuing educational and study abroad opportunities, invests in programs that build
        life skills, contributes to organizations that assist cancer patients and their families, and partners with
        community initiatives that strengthen the places we call home.
      </p>
      <p>
        While our roots are firmly planted in Benicia, we believe kindness has no boundaries. Every scholarship awarded,
        every student encouraged, every family supported, and every community project funded represents another ripple
        spreading outward into the world.
      </p>
      <p>
        The Ripple Effect of Life is more than an organization. It is a reflection of the values James Baldwin has
        demonstrated throughout his life: service, generosity, resilience, and a belief that we all have the ability to
        make a difference.
      </p>
    </SectionHeading>
    <div class="reveal mx-auto max-w-2xl border-t border-gold/40 pt-10 text-center font-playfair text-[1.35rem] leading-relaxed text-navy-deep italic md:text-[1.6rem]">
      <p>His journey inspired our mission.</p>
      <p>His legacy fuels our purpose.</p>
      <p>And together, we are creating ripples that will continue for generations to come.</p>
    </div>
  </Section>

  <!-- Recognition -->
  <Section tone="white" compact class="border-t border-navy-deep/8">
    <div class="reveal flex flex-col items-center gap-6 text-center md:flex-row md:text-left">
      <p class="font-playfair text-[3.5rem] leading-none font-bold text-gold-dark md:text-[4.5rem]">2nd</p>
      <div>
        <Eyebrow class="mb-2 justify-center md:justify-start">Best of Benicia 2026</Eyebrow>
        <p class="mb-1 font-playfair text-[1.5rem] font-bold text-navy-deep">Best Community Foundation/Fundraising</p>
        <p class="text-text-mid">
          Just five months after we were founded, we placed second in the Benicia Chamber of Commerce's Best of Benicia
          awards. Thank you, Benicia! Your support is what makes ripples possible.
        </p>
      </div>
    </div>
  </Section>

  <!-- Board -->
  <Section tone="navy">
    <SectionHeading eyebrow="Leadership" title="Our Board" tone="light" />
    <div class="mb-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        board.map(({ data: member }, i) => (
          <div class={`reveal reveal-d${Math.min(i + 1, 4)} border border-gold/15 bg-white/5 p-8`}>
            {member.photo ? (
              <Photo
                src={member.photo}
                alt={member.name}
                width={128}
                class="mb-5 size-16 rounded-full border border-gold/30 object-cover"
              />
            ) : (
              <div class="mb-5 flex size-16 items-center justify-center border border-gold/30 bg-gold/15">
                <span class="font-playfair text-xl font-bold text-gold">{initials(member.name)}</span>
              </div>
            )}
            <h3 class="mb-1 font-playfair text-[1.15rem] font-bold text-white">{member.name}</h3>
            <p class="mb-4 text-[0.75rem] font-semibold tracking-[0.08em] text-gold uppercase">{member.role}</p>
            <p class="text-sm leading-relaxed text-white/70">{member.bio}</p>
          </div>
        ))
      }
    </div>
    <div class="reveal flex flex-col gap-4 border-t border-gold/15 pt-10 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-white/60">Interested in supporting the foundation's leadership?</p>
      <Button href="/contact" variant="secondary" size="sm">Get in Touch</Button>
    </div>
  </Section>

  <CallToAction eyebrow="Join Us" title="Be Part of the Legacy">
    Join us in honoring James Baldwin's life of service through donations and community involvement.
    <Fragment slot="actions">
      <Button href="/get-involved" variant="gold">Get Involved</Button>
    </Fragment>
  </CallToAction>
</Layout>
