---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
---

<Layout title="About Us | The Ripple Effect of Life" description="Kelly Baldwin created The Ripple Effect of Life to honor her father, James Baldwin,a lifelong community leader in Benicia, California.">
  <Navbar />

  <main class="mt-[72px]">

    <PageHeader
      eyebrow="Our Story"
      title="About The Ripple Effect of Life"
      subtitle="Founded by Kelly Baldwin in honor of her father,a man whose life of service has shaped an entire community."
    />

    <!-- Founding Story -->
    <section class="bg-cream py-20 md:py-32">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="reveal">
            <p class="text-[0.75rem] font-semibold tracking-[0.15em] uppercase text-gold font-inter mb-3">Why This Foundation Exists</p>
            <h2 class="text-[2rem] md:text-[2.75rem] font-bold text-navy-deep leading-[1.15] font-playfair mb-5">
              A Daughter's Tribute
            </h2>
            <p class="text-[1rem] md:text-[1.05rem] leading-[1.85] text-text-mid font-inter mb-5">
              Kelly Baldwin created The Ripple Effect of Life to honor her father, James Baldwin. She has watched firsthand the way he has shown up for others: coaching youth sports, mentoring young people, organizing community events, and giving freely of his time without expectation of recognition.
            </p>
            <p class="text-[1rem] md:text-[1.05rem] leading-[1.85] text-text-mid font-inter">
              This foundation is built on that same principle: that the kindness one person shows creates ripples far beyond what any of us can measure. Through scholarships and community events, The Ripple Effect of Life carries that spirit forward,ensuring James's legacy of service inspires future generations.
            </p>
          </div>
          <div class="reveal reveal-d1">
            <img
              src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=900&q=80"
              alt="Community gathering"
              class="w-full h-80 lg:h-[420px] object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- James Baldwin -->
    <section id="james" class="bg-navy-deep py-20 md:py-32">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <!-- Image with offset border -->
          <div class="relative reveal">
            <div class="absolute -top-4 -left-4 right-4 bottom-4 border border-[rgba(212,165,116,0.4)] -z-10"></div>
            <img
              src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=900&q=80"
              alt="Community"
              class="w-full h-80 lg:h-[460px] object-cover"
              loading="lazy"
            />
          </div>

          <div class="reveal reveal-d1">
            <p class="text-[0.75rem] font-semibold tracking-[0.15em] uppercase text-gold font-inter mb-3">The Man</p>
            <h2 class="text-[2rem] md:text-[2.75rem] font-bold text-white leading-[1.15] font-playfair mb-5">
              James Baldwin
            </h2>
            <p class="text-[1rem] md:text-[1.05rem] leading-[1.85] text-[rgba(255,255,255,0.8)] font-inter mb-5">
              James Baldwin is a lifelong community leader in Benicia, California. For decades, he has dedicated himself to the people around him: coaching youth sports, mentoring young men and women, and organizing community events that bring neighbors together.
            </p>
            <p class="text-[1rem] md:text-[1.05rem] leading-[1.85] text-[rgba(255,255,255,0.8)] font-inter mb-5">
              What defines James is not grand gestures, but consistency. He shows up. He listens. He gives his time. Year after year, person after person, James has quietly shaped the fabric of his community in ways that are hard to fully capture,but impossible to miss when you've been on the receiving end of his generosity.
            </p>
            <p class="text-[1rem] md:text-[1.05rem] leading-[1.85] text-[rgba(255,255,255,0.8)] font-inter">
              The Ripple Effect of Life exists because of him,and because of the belief that his example is worth honoring and continuing.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission -->
    <section class="bg-cream py-20 md:py-28">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="max-w-2xl mx-auto text-center reveal">
          <p class="text-[0.75rem] font-semibold tracking-[0.15em] uppercase text-gold font-inter mb-3">Our Mission</p>
          <h2 class="text-[2rem] md:text-[2.5rem] font-bold text-navy-deep leading-[1.15] font-playfair mb-5">What We Stand For</h2>
          <p class="text-[1rem] md:text-[1.05rem] leading-[1.85] text-text-mid font-inter mb-4">
            We believe that one person's commitment to service can change a community. Through scholarships, community events, and initiatives that bring people together, we work to ensure that James Baldwin's values of generosity, mentorship, and service continue to take root in the next generation.
          </p>
          <p class="text-[1rem] md:text-[1.05rem] leading-[1.85] text-text-mid font-inter">
            Every scholarship awarded, every event organized, every volunteer hour given: these are ripples. And ripples spread.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-navy-deep py-16 md:py-20">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12 text-center">
        <h2 class="text-[1.75rem] md:text-[2.25rem] font-bold font-playfair text-white mb-4">Be Part of the Legacy</h2>
        <p class="text-[rgba(255,255,255,0.6)] font-inter text-sm leading-relaxed mb-8 max-w-md mx-auto">Join us in honoring James Baldwin's life of service through donations and community involvement.</p>
        <Button href="/get-involved" variant="gold" size="md">Get Involved</Button>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
