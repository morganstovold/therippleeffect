---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
---

<Layout title="Our Impact | The Ripple Effect of Life" description="Explore the impact of The Ripple Effect of Life foundation. From scholarships to community events, see how every ripple creates lasting change.">
  <Navbar />

  <main class="mt-[90px]">
    <!-- Page Header -->
    <PageHeader
      eyebrow="Our Ripple"
      title="Our Impact"
      subtitle="From scholarship recipients to community events, see how every ripple creates lasting change."
    />

    <!-- Impact Stats Section -->
    <section class="bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 md:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-6 mb-12">
          <!-- Stat Card 1 -->
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-playfair font-bold text-navy-deep mb-3">
              1
            </div>
            <p class="font-inter text-text-mid text-lg">Scholarships Awarded</p>
          </div>

          <!-- Stat Card 2 -->
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-playfair font-bold text-navy-deep mb-3">
              1
            </div>
            <p class="font-inter text-text-mid text-lg">Inaugural Events Planned</p>
          </div>

          <!-- Stat Card 3 -->
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-playfair font-bold text-navy-deep mb-3">
              100+
            </div>
            <p class="font-inter text-text-mid text-lg">Community Members Engaged</p>
          </div>

          <!-- Stat Card 4 -->
          <div class="text-center">
            <div class="text-5xl md:text-6xl font-playfair font-bold text-navy-deep mb-3">
              $5,000+
            </div>
            <p class="font-inter text-text-mid text-lg">Funds Raised</p>
          </div>
        </div>

        <!-- Stats Description -->
        <div class="max-w-3xl mx-auto text-center">
          <p class="font-inter text-text-mid text-lg leading-relaxed">
            The Ripple Effect of Life is just getting started. Every scholarship awarded, every event hosted, and every community member engaged creates ripples of positive change. These numbers represent the beginning of something remarkable—a movement dedicated to honoring legacy and creating opportunity for generations to come.
          </p>
        </div>
      </div>
    </section>

    <!-- Stories Section -->
    <section class="bg-cream py-16 md:py-24">
      <div class="container mx-auto px-4 md:px-8">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <p class="font-inter text-gold-dark uppercase tracking-widest text-sm font-semibold mb-3">
            Stories of Impact
          </p>
          <h2 class="font-playfair text-4xl md:text-5xl font-bold text-navy-deep mb-4">
            The Ripple Continues
          </h2>
        </div>

        <!-- Stories Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6">
          <!-- Story Card 1 -->
          <a href="/stories/golf-classic" class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
            <div class="h-48 bg-gradient-to-br from-navy-mid to-navy-rich"></div>
            <div class="p-6">
              <p class="text-gold-dark font-inter text-xs uppercase tracking-widest font-semibold mb-2">
                May 2026
              </p>
              <h3 class="font-playfair text-2xl font-bold text-navy-deep mb-3">
                Launching the First Golf Classic
              </h3>
              <p class="font-inter text-text-mid mb-4 line-clamp-3">
                Join us for our inaugural golf event in May 2026, bringing together community members to support scholarships and honor the legacy we're building.
              </p>
              <span class="inline-block font-inter text-gold font-semibold hover:text-gold-dark transition-colors">
                Read More →
              </span>
            </div>
          </a>

          <!-- Story Card 2 -->
          <a href="/stories/baldwins-legacy" class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
            <div class="h-48 bg-gradient-to-br from-navy-rich to-navy-deep"></div>
            <div class="p-6">
              <p class="text-gold-dark font-inter text-xs uppercase tracking-widest font-semibold mb-2">
                Our Story
              </p>
              <h3 class="font-playfair text-2xl font-bold text-navy-deep mb-3">
                Honoring James Baldwin's Legacy
              </h3>
              <p class="font-inter text-text-mid mb-4 line-clamp-3">
                Discover the inspiration behind The Ripple Effect of Life and how we're honoring a remarkable life through scholarship and community engagement.
              </p>
              <span class="inline-block font-inter text-gold font-semibold hover:text-gold-dark transition-colors">
                Read More →
              </span>
            </div>
          </a>

          <!-- Story Card 3 -->
          <a href="/stories/first-recipients" class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
            <div class="h-48 bg-gradient-to-br from-gold-dark to-gold"></div>
            <div class="p-6">
              <p class="text-gold-dark font-inter text-xs uppercase tracking-widest font-semibold mb-2">
                2026
              </p>
              <h3 class="font-playfair text-2xl font-bold text-navy-deep mb-3">
                First Scholarship Recipients
              </h3>
              <p class="font-inter text-text-mid mb-4 line-clamp-3">
                Meet the talented individuals whose lives are being transformed by The Ripple Effect of Life scholarship program.
              </p>
              <span class="inline-block font-inter text-gold font-semibold hover:text-gold-dark transition-colors">
                Read More →
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- News/Updates Section -->
    <section class="bg-white py-16 md:py-24">
      <div class="container mx-auto px-4 md:px-8">
        <!-- Section Header -->
        <div class="mb-12">
          <h2 class="font-playfair text-4xl md:text-5xl font-bold text-navy-deep mb-2">
            Latest News
          </h2>
        </div>

        <!-- News Items -->
        <div class="max-w-3xl space-y-6">
          <!-- News Item 1 -->
          <div class="border-l-4 border-gold pl-6 py-4">
            <p class="text-gold-dark font-inter text-sm font-semibold mb-1">
              May 28, 2026
            </p>
            <h3 class="font-playfair text-2xl font-bold text-navy-deep mb-2">
              Registration Open for Golf Classic
            </h3>
            <p class="font-inter text-text-mid leading-relaxed">
              The registration for our inaugural Golf Classic is now live! Join us on May 28, 2026, for an unforgettable day of golf, networking, and community. All proceeds support our scholarship program.
            </p>
          </div>

          <!-- News Item 2 -->
          <div class="border-l-4 border-gold pl-6 py-4">
            <p class="text-gold-dark font-inter text-sm font-semibold mb-1">
              April 10, 2026
            </p>
            <h3 class="font-playfair text-2xl font-bold text-navy-deep mb-2">
              Scholarship Applications Now Accepted
            </h3>
            <p class="font-inter text-text-mid leading-relaxed">
              We're excited to announce that applications for The Ripple Effect of Life scholarship program are now being accepted. Apply by April 10, 2026, for your chance to transform your future.
            </p>
          </div>

          <!-- News Item 3 -->
          <div class="border-l-4 border-gold pl-6 py-4">
            <p class="text-gold-dark font-inter text-sm font-semibold mb-1">
              April 2026
            </p>
            <h3 class="font-playfair text-2xl font-bold text-navy-deep mb-2">
              Foundation Officially Launched
            </h3>
            <p class="font-inter text-text-mid leading-relaxed">
              The Ripple Effect of Life nonprofit foundation is officially here. We're dedicated to creating opportunities and honoring legacy through scholarships, community events, and meaningful engagement.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-navy-deep py-16 md:py-20">
      <div class="container mx-auto px-4 md:px-8 text-center">
        <h2 class="font-playfair text-4xl md:text-5xl font-bold text-white mb-8">
          Be Part of Our Story
        </h2>
        <div class="flex flex-col md:flex-row justify-center gap-4 md:gap-6">
          <Button
            href="/contact"
            variant="gold"
            size="md"
            class="md:w-auto"
          >
            Share Your Story
          </Button>
          <Button
            href="/get-involved"
            variant="secondary"
            size="md"
            class="md:w-auto"
          >
            Get Involved
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
