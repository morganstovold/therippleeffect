---
import Button from "../components/Button.astro";
import CallToAction from "../components/CallToAction.astro";
import ImpactStats from "../components/ImpactStats.astro";
import PageHeader from "../components/PageHeader.astro";
import PostCard from "../components/PostCard.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../lib/content";

const stories = (await getPosts()).slice(0, 3);
---

<Layout
  title="Our Impact"
  description="Explore the impact of The Ripple Effect of Life foundation. From scholarships to community events, see how every ripple creates lasting change."
>
  <PageHeader
    eyebrow="Our Ripple"
    title="Our Impact"
    subtitle="From scholarship recipients to community events, see how every ripple creates lasting change."
  />

  <Section tone="white">
    <div class="mb-12">
      <ImpactStats />
    </div>
    <p class="reveal mx-auto max-w-3xl text-center text-[1.05rem] leading-[1.85] text-text-mid">
      The Ripple Effect of Life is just getting started. Every scholarship awarded, every event hosted, and every community
      member engaged creates ripples of positive change. These numbers represent the beginning of something remarkable: a
      movement dedicated to honoring legacy and creating opportunity for generations to come.
    </p>
  </Section>

  <Section tone="cream">
    <SectionHeading eyebrow="Stories of Impact" title="The Ripple Continues" />
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {stories.map((post, i) => <PostCard post={post} showExcerpt class={`reveal reveal-d${i + 1}`} />)}
    </div>
  </Section>

  <CallToAction eyebrow="Join Us" title="Be Part of Our Story">
    Every story here started with someone who decided to help. Yours could be next.
    <Fragment slot="actions">
      <Button href="/contact" variant="gold">Share Your Story</Button>
      <Button href="/get-involved" variant="secondary">Get Involved</Button>
    </Fragment>
  </CallToAction>
</Layout>
