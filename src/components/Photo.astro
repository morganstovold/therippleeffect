---
import type { ImageMetadata } from "astro";
import { unsplashSrcset } from "../lib/images";
import LocalImage from "./LocalImage.astro";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  /** Largest width this photo is shown at, in CSS pixels. */
  width: number;
  sizes?: string;
  /** Load immediately and at high priority. Use for the main image at the top of a page. */
  priority?: boolean;
  class?: string;
}

const { src, alt, width, sizes = "100vw", priority = false, class: className } = Astro.props;
const loading = priority ? "eager" : "lazy";
const fetchpriority = priority ? "high" : undefined;
const remote = typeof src === "string" ? unsplashSrcset(src, width) : undefined;
---

{
  remote ? (
    <img
      src={remote.src}
      srcset={remote.srcset}
      sizes={sizes}
      alt={alt}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
    />
  ) : (
    <LocalImage
      src={src as ImageMetadata}
      alt={alt}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  )
}
