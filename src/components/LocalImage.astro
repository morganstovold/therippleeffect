---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & { src: ImageMetadata; alt: string };

// Points straight at the hashed file in /_astro instead of Astro's /_image endpoint.
// Images aren't resized on Cloudflare anyway, so this skips a Worker request per image.
const { src, loading = "lazy", decoding = "async", ...rest } = Astro.props;
---

<img src={src.src} width={src.width} height={src.height} loading={loading} decoding={decoding} {...rest} />
