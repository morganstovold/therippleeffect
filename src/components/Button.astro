---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> &
  HTMLAttributes<"button"> & {
    variant?: "primary" | "secondary" | "gold";
    size?: "sm" | "md" | "lg";
  };

const { href, variant = "primary", size = "md", class: className, type = "button", ...rest } = Astro.props;

// Each variant has a resting background and a colour that slides in from the left on hover.
const variants = {
  primary: { text: "text-white hover:text-navy-deep", base: "bg-navy-deep", slide: "bg-gold" },
  secondary: {
    text: "text-white border-2 border-gold hover:text-navy-deep",
    base: "bg-transparent",
    slide: "bg-gold",
  },
  gold: {
    text: "text-navy-deep border-2 border-gold hover:text-white hover:border-navy-deep",
    base: "bg-gold",
    slide: "bg-navy-deep",
  },
};

const sizes = {
  sm: "px-5 py-2.5 text-xs",
  md: "px-8 py-3.5 text-sm",
  lg: "px-12 py-5 text-base",
};

const { text, base, slide } = variants[variant];
const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={[
    "group/btn relative inline-block cursor-pointer overflow-hidden font-semibold tracking-[0.05em] whitespace-nowrap uppercase no-underline transition-all ease-out",
    text,
    sizes[size],
    className,
  ]}
  {...rest}
>
  <span class:list={["absolute inset-0", base]}></span>
  <span
    class:list={[
      "absolute inset-0 origin-left scale-x-0 transition-transform duration-400 ease-out group-hover/btn:scale-x-100",
      slide,
    ]}
  ></span>
  <span class="relative z-10"><slot /></span>
</Tag>
