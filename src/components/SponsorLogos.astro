---
import LocalImage from "./LocalImage.astro";
import { getSponsors } from "../lib/content";

const { businesses } = await getSponsors();
---

<ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
  {
    businesses.map((sponsor) => {
      const logo = (
        <LocalImage
          src={sponsor.logo}
          alt={sponsor.name}
          title={sponsor.name}
          class="max-h-full w-auto max-w-full object-contain"
        />
      );
      return (
        <li class="flex aspect-[3/2] items-center justify-center border border-navy-deep/10 bg-white p-4 transition-shadow duration-300 hover:shadow-lg md:p-5">
          {sponsor.url ? (
            <a href={sponsor.url} target="_blank" rel="noopener" class="flex h-full w-full items-center justify-center">
              {logo}
            </a>
          ) : (
            logo
          )}
        </li>
      );
    })
  }
</ul>
