---
import { footerNav, site } from "../site";
import SocialLinks from "./SocialLinks.astro";

const linkClass = "text-[0.875rem] font-light text-white/75 no-underline transition-colors duration-200 hover:text-white";
const headingClass = "mb-5 text-[0.7rem] font-semibold tracking-[0.15em] text-white/55 uppercase";
---

<footer class="border-t-2 border-gold/45 bg-navy-deep pt-16 pb-8 md:pt-20">
  <div class="page-container">
    <div class="mb-8 grid grid-cols-1 gap-10 border-b border-white/8 pb-12 md:grid-cols-2 md:gap-12 lg:grid-cols-4">
      <div class="md:col-span-2 lg:col-span-1">
        <p class="font-playfair text-[1.4rem] leading-tight font-bold text-white">The Ripple Effect</p>
        <span class="mt-0.5 mb-3 block text-[0.6rem] font-light tracking-[0.18em] text-gold uppercase">of Life</span>
        <p class="mb-4 max-w-xs text-sm leading-[1.8] font-light text-white/70">
          A foundation honoring James Baldwin's legacy of service, created by his wife Terry and daughter Kelly.
        </p>
        <p class="text-[0.7rem] tracking-[0.05em] text-gold italic">{site.tagline}</p>
      </div>

      {
        Object.entries(footerNav).map(([heading, links]) => (
          <div>
            <p class={headingClass}>{heading}</p>
            <ul class="m-0 list-none space-y-3 p-0">
              {links.map(({ href, label }) => (
                <li>
                  <a href={href} class={linkClass}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <p class={headingClass}>Contact</p>
        <ul class="m-0 list-none space-y-3 p-0">
          <li><a href={`mailto:${site.email}`} class={linkClass}>{site.email}</a></li>
          <li><a href="/contact" class={linkClass}>Contact Us</a></li>
          <li>
            <address class="text-[0.875rem] font-light text-white/75 not-italic">
              {site.address.street}
              <br />
              {site.address.city}
            </address>
          </li>
        </ul>
        <SocialLinks class="mt-5" />
      </div>
    </div>

    <p class="text-center text-[0.75rem] font-light text-white/60">
      &copy; {new Date().getFullYear()} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
