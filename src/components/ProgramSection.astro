---
import { type CollectionEntry, render } from "astro:content";
import Button from "./Button.astro";
import Section from "./Section.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  program: CollectionEntry<"programs">;
  tone: "white" | "cream";
}

const { program, tone } = Astro.props;
const { title, eyebrow, highlights, details, links } = program.data;
const { Content } = await render(program);
---

<Section tone={tone} id={program.id}>
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-[3fr_2fr] lg:gap-16">
    <div>
      <SectionHeading eyebrow={eyebrow} title={title} class="mb-8">
        <Content />
      </SectionHeading>

      {
        highlights.length > 0 && (
          <ul class="reveal mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {highlights.map((highlight) => (
              <li class="border-t-2 border-gold bg-white p-6">
                <p class="mb-1 font-playfair text-lg font-bold text-navy-deep">{highlight.title}</p>
                <p class="text-sm leading-relaxed text-text-mid">{highlight.text}</p>
              </li>
            ))}
          </ul>
        )
      }

      {
        links.length > 0 && (
          <div class="reveal flex flex-col gap-4 sm:flex-row">
            {links.map((link, i) => (
              <Button href={link.url} variant={i === 0 ? "gold" : "primary"}>
                {link.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>

    {
      details.length > 0 && (
        <dl class="reveal reveal-d1 self-start border-t-4 border-gold bg-navy-deep p-8 md:p-10">
          {details.map((detail) => (
            <div class="border-b border-white/10 py-4 first:pt-0 last:border-0 last:pb-0">
              <dt class="mb-1 text-[0.7rem] font-semibold tracking-[0.15em] text-gold uppercase">{detail.label}</dt>
              <dd class="text-[0.95rem] leading-relaxed text-white/85">
                {detail.url ? (
                  <a href={detail.url} class="underline decoration-gold/50 underline-offset-4 hover:text-gold">
                    {detail.value}
                  </a>
                ) : (
                  detail.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</Section>
