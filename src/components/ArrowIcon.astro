---
interface Props {
  direction?: "forward" | "back";
  class?: string;
}

const { direction = "forward", class: className = "size-4" } = Astro.props;
---

<svg
  class:list={[className, direction === "back" && "rotate-180"]}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
</svg>
